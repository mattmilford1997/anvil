---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import Section from '../../components/Section.astro';
import Tiles from '../../components/Tiles.astro';
import Timeline from '../../components/Timeline.astro';
import { getLivePost } from '../../lib/content';
const when = await getLivePost('when-to-accept-insurance');
const twoPhase = await getLivePost('cash-pay-to-insurance-two-phase-plan');
const five = await getLivePost('five-workstreams-insurance-operations');
const faqs = [
  { q: 'How do I accept insurance as a virtual care company?', a: 'Start cash-pay to insurance in the states where your patients already are. Roster-add clinicians for in-network telehealth in every state you launch, keep cash-pay as the fallback, and form your own PC in parallel so DTC to in-network is an asset, not a lease.' },
  { q: 'We are cash-pay today. Where do we start?', a: 'Pick the 3 to 5 states with the most covered lives among your patients and clinicians. We roster-add those clinicians under our contracts, turn on eligibility at booking, and keep cash-pay as the fallback path. Your own PC forms in the same states at the same time.' },
  { q: 'Will adding insurance hurt our booking conversion?', a: 'It hurts when the insurance step asks for a card upload and a wait. It helps when a soft check at booking tells the patient they are covered and what the copay is. The commonly cited lift is 2 to 5x on the insurance path.' },
  { q: 'Do we need to hire anyone?', a: 'No. Contracting, credentialing, eligibility, coding, and denials are all delivered. You keep one ops owner as the point of contact.' },
  { q: 'What will our Series B diligence see?', a: 'Insured revenue billed under an entity you control, payer contracts in your name, and a vendor you could replace without relaunching. That is the point of doing both tracks.' },
];
---
<SubpageLayout
  metaTitle="Virtual care: cash-pay to in-network in every state"
  title="Cash-pay to in-network, in every state, without hiring a billing department."
  description="Accept insurance as a virtual care company: cash-pay to insurance and in-network telehealth in every state. Launch in weeks, own contracts by year one."
  eyebrow="Solutions / Virtual care"
  sub="Accept insurance as a virtual care company without building the five teams it usually takes. Your board is asking about TAM; competitors already take insurance. Go cash-pay to in-network telehealth in every state, and own the result."
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Solutions', path: '/solutions/virtual-care' }, { name: 'Virtual care', path: '/solutions/virtual-care' }]}
  faqs={faqs}
  ctaTitle="Launch in your top states this quarter."
  ctaBody="Tell us your states, clinicians, and codes. We map the first 90 days and the migration after it."
  ctaPrimary={{ label: 'Get started', href: '/contact?src=virtual-care' }}
>
  <Section eyebrow="Why now" title="Cash-pay to insurance, including DTC to in-network">
    <p class="lede">Cash-pay to insurance is the move most virtual care boards ask for. DTC to in-network does not have to crater conversion if eligibility runs before the price screen, and it does not have to leave you on a rented network if your own PC forms on day one.</p>
    <Tiles items={[
      { icon: 'chart', title: 'Cash-pay TAM has a ceiling', body: 'Most of the market pays with a card they already have: their insurance card. Every month you stay cash-only, you buy the same patients at a higher CAC.' },
      { icon: 'clock', title: 'Insurance takes quarters unless it takes weeks', body: 'New contracts take quarters. Roster-adds to contracts that exist take weeks. The difference is whether you launch this quarter or next year.' },
      { icon: 'key', title: 'Diligence will ask who owns the contracts', body: 'Investors know what network rental means. The right answer is that you launched on rental and own the contracts now.' },
    ]} />
  </Section>
  <Section eyebrow="Coverage" title="In-network telehealth in every state">
    <p class="lede">In-network telehealth in every state starts as roster-adds on contracts that already exist, then moves to contracts in your name. You do not wait for fifty new negotiations before the first insured visit.</p>
  </Section>
  <Section eyebrow="The plan" title="Week 1 to month 12" tight>
    <Timeline />
  </Section>
  <Section eyebrow="Read next" title="For founders doing this for the first time" tight>
    <div class="grid grid-3">
      {when && <div class="card"><h3><a href={`/resources/${when.id}`}>When to accept insurance</a></h3><p class="muted">Seven signals and a scoring table.</p></div>}
      {twoPhase && <div class="card"><h3><a href={`/resources/${twoPhase.id}`}>The two-phase plan</a></h3><p class="muted">Add insurance without cratering conversion.</p></div>}
      {five && <div class="card"><h3><a href={`/resources/${five.id}`}>The five workstreams</a></h3><p class="muted">Which ones you should never build.</p></div>}
      <div class="card"><h3><a href="/own-your-contracts">Own your payer contracts</a></h3><p class="muted">Launch on rental, then migrate volume to an entity you control.</p></div>
      <div class="card"><h3><a href="/compare/bridge">Bridge alternative</a></h3><p class="muted">Network rental vs owning the contracts, side by side.</p></div>
      <div class="card"><h3><a href="/resources">Insurance ops guides</a></h3><p class="muted">Queued October guides on accepting insurance and payer contracting. Live articles appear here when they publish.</p></div>
    </div>
  </Section>
</SubpageLayout>
