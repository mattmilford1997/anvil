---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import RateLookup from '../components/RateLookup.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { samplePairs, longTail90837Pairs, ratePath, stateName, codeLabel, codeAnchorName, ratesFile, codesInData, ratesByJurisdiction, ratePairs, stateHubPath, codeHubPath } from '../lib/rates';
import WedgeRelated from '../components/WedgeRelated.astro';
const jurisdictions = ratesByJurisdiction();
const allStateHrefs = jurisdictions.flatMap((j) => j.pairs.map((p) => ratePath(p.state, p.code)));
if (new Set(allStateHrefs).size !== ratePairs().length) {
  throw new Error(`all-states index has ${new Set(allStateHrefs).size} links; routes have ${ratePairs().length}`);
}
const samples = samplePairs();
const longTail90837 = longTail90837Pairs();
const codes = codesInData();
const codeList = codes.length > 1 ? `${codes.slice(0, -1).join(', ')}, and ${codes[codes.length - 1]}` : (codes[0] ?? '');
const faqs = [
  { q: 'Where can I find reimbursement rates by state and CPT code?', a: 'Use the lookup, or open a page such as 90837 in Ohio. Ranges come from Parite. They are not a guarantee of what you will be paid.' },
  { q: 'Do you publish a Medicaid reimbursement rate for 90837?', a: 'Yes, as a range, in states where Parite has a Medicaid FFS figure. Ohio 90837 and California 90837 are examples. If Medicaid FFS is missing for a state, that row stays blank until Parite has it.' },
  { q: 'Where can I find telehealth reimbursement rates by payer?', a: 'Use the lookup or open a state and code pair. Each pair is a table of telehealth reimbursement rates by payer for that CPT code (Medicare PFS, Medicaid FFS, and UHC TiC where Parite has the number). The lookup has the same payer filter.' },
  { q: 'Will you publish psychotherapy reimbursement rates by state?', a: 'Yes. 90837, 90834, and 90791 have a page per state. 97153 appears in states where Parite has Medicaid FFS. We add codes when Parite has them.' },
  { q: 'Where do these numbers come from?', a: 'From Parite, which aggregates contracted and published reimbursement data by state, payer, and code. Anvil shows ranges, not individual contract terms. Source labels (Medicare PFS, Medicaid FFS, UHC TiC) are Parite\'s.' },
  { q: 'Are these the rates I will be paid?', a: 'No. They are published ranges for planning. Your contracted rate depends on the payer, the entity, the specialty, and the negotiation. Under rental you see the actual contracted rate on every statement.' },
  { q: 'Why is a code missing for my state?', a: 'A range appears when Parite has the number. Ask us for the state and code and we will send what we have. We add codes when Parite has them.' },
  { q: 'How do you use this in contracting?', a: 'As the floor for rate proposals in your entity\'s name, and the benchmark when we tell you a payer\'s offer is low.' },
];
---
<BaseLayout title="Reimbursement rates by state and CPT code" description="Reimbursement rates by state and CPT code, including the Medicaid rate for 90837 and telehealth reimbursement by payer. Built from Parite data." jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Rates', path: '/rates' }])]}>
  <Hero compact eyebrow="Rates" title="Reimbursement rates by state and CPT code: what payers actually pay." sub="Look up reimbursement rates by state and CPT code, then filter telehealth reimbursement by payer, before you sign with anyone, including us. Medicaid reimbursement rate for 90837, telehealth reimbursement by payer, and psychotherapy reimbursement rates by state are in the lookup and on per-state pages built from Parite." primary={{ label: 'Get a contracting plan', href: '/contact?src=rates' }} />
  <Section eyebrow="The hub" title="Reimbursement rates by state and CPT code" intro={`Look up telehealth reimbursement rates by payer for ${codeList} by state. The numbers come from Parite. They are published ranges for planning, not a guarantee of what you will be paid. Each state and code pair is a payer table.`}>
    <div class="grid grid-2">
      <div class="card"><h3>Medicaid reimbursement rate for 90837</h3><p class="muted">Psychotherapy, 60 minutes, is the code most behavioral health companies model first. Start with <a href={ratePath('OH', '90837')}>90837 reimbursement rate in Ohio by payer (2026)</a>, then use the lookup for your state.</p></div>
      <div class="card"><h3>Psychotherapy reimbursement rates by state</h3><p class="muted">90837, 90834, and 90791 have a page per state. 97153 (ABA) appears in states where Parite has Medicaid FFS. We add codes when Parite has them.</p></div>
    </div>
    <p class="lede" style="margin-top:24px">Use the tables when you <a href="/own-your-contracts">own your payer contracts</a> and when you plan <a href="/solutions/behavioral-health">behavioral health payer contracting</a>. The <a href="/compare/bridge">Bridge alternative</a> fact table is the vendor comparison. Structure for the contracts sits on <a href="/platform/compliance">CPOM and the MSO-PC</a>. Leaving a rental vendor starts on <a href="/solutions/switching">switching</a>.</p>
  </Section>
  <Section id="rates-by-payer" eyebrow="By payer" title="Telehealth reimbursement rates by payer">
    <p class="lede">Telehealth reimbursement rates by payer are the rows of the table on each state and CPT code page, for example <a href={ratePath('OH', '90837')}>90837 in Ohio</a>. Where Parite has a number, the table shows Medicare PFS, Medicaid FFS, and UnitedHealthcare TiC.</p>
  </Section>
  <Section tight>
    <RateLookup />
  </Section>
  <Section eyebrow="Long tail" title="90837 reimbursement rate by state" intro="Psychotherapy, 60 minutes, is the code most practices model first. Start with Ohio or California, then open your own state.">
    <ul class="check-list">
      {longTail90837.map((p) => (
        <li>
          <a href={ratePath(p.state, p.code)}>{p.code} reimbursement rate in {stateName(p.state)} by payer (2026)</a>
          <span class="muted">. {codeLabel(p.code)}, {p.rows.length} payer{p.rows.length === 1 ? '' : 's'}</span>
        </li>
      ))}
    </ul>
  </Section>
  <Section eyebrow="More codes" title="Other states and codes you can open now" intro="90834, 90791, and ABA 97153 where we have them, plus more 90837 states. Open the one that matches how you bill.">
    <ul class="check-list">
      {samples.map((p) => (
        <li>
          <a href={ratePath(p.state, p.code)}>{p.code} reimbursement rate in {stateName(p.state)} by payer (2026)</a>
          <span class="muted">. {codeLabel(p.code)}, {p.rows.length} payer{p.rows.length === 1 ? '' : 's'}</span>
        </li>
      ))}
    </ul>
  </Section>
  <Section id="all-states" eyebrow="All states" title="Reimbursement rates by state and CPT code, all states" intro="Every published state and CPT code page. Open the code you bill.">
    <ul class="all-states">
      {jurisdictions.map((j) => (
        <li>
          <strong><a href={stateHubPath(j.state)}>{j.name} therapy reimbursement rates by CPT code</a>:</strong>{' '}
          {j.pairs.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={ratePath(p.state, p.code)}>{p.code} {codeAnchorName(p.code)} in {j.name}</a>
            </>
          ))}
        </li>
      ))}
    </ul>
  </Section>
  <Section eyebrow="By code" title="Reimbursement rates by CPT code" intro="One page per code, linking every state where Parite has a range.">
    <ul class="check-list">
      {codes.map((code) => (
        <li><a href={codeHubPath(code)}>{code} reimbursement rates by state</a> <span class="muted">. {codeLabel(code)}</span></li>
      ))}
    </ul>
  </Section>
  <Section eyebrow="Methodology" title="How to read the ranges" tight>
    <div class="grid grid-2">
      <div class="card"><h3>What a range is</h3><p class="muted">The low and high of contracted and published allowed amounts for the code in that state, across the payers we have data for. Per unit, before patient responsibility. Not a guarantee.</p></div>
      <div class="card"><h3>How we use it for you</h3><p class="muted">As the floor in rate proposals for your entity and the benchmark for renewals. When a payer offers below the range, we say so and we push. When it is above, we take it.</p></div>
    </div>
    <p class="small muted" style="margin-top:16px">Source: {ratesFile.source ?? 'Parite'}. Medicare figures are CMS PFS RVU26C non-facility. Medicaid figures are official state Medicaid FFS. UHC figures are UHC OHBS TiC professional outpatient.</p>
  </Section>
  <WedgeRelated current="/rates" />
  <Section tight><Faq items={faqs} /></Section>
  <CtaBand title="Know the rate. Then get the contract." body="Send us your codes and states. We come back with payer order, timelines, and the ranges to plan on." primary={{ label: 'Get a contracting plan', href: '/contact?src=rates' }} secondary={{ label: 'See pricing', href: '/pricing' }} />
</BaseLayout>
<style>
  .all-states { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .all-states li { font-size: 15px; line-height: 1.55; }
</style>
