---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbJsonLd, showHeld, fmtDate } from '../../lib/seo';
import { getPosts, getUpcomingOctoberPosts } from '../../lib/content';
const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const liveIds = new Set(posts.map((p) => p.id));
const octUpcoming = (await getUpcomingOctoberPosts()).filter((p) => !liveIds.has(p.id));
const cats = ['All', 'Blog', 'Report', 'Guide', 'News'];
---
<BaseLayout title="Resources: insurance ops guides for care companies" description="Insurance ops guides for care companies: accepting insurance, credentialing, and payer contracting, with frameworks and cost tables for founders." jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Resources', path: '/resources' }])]}>
  <section class="res-hero"><div class="container"><div class="eyebrow">Resources</div><h1>Insurance ops guides for care companies</h1><p class="lede">Insurance ops guides for care companies. Accepting insurance, credentialing, and payer contracting, with frameworks and cost tables. Live articles end with a tool, not a pitch.</p></div></section>
  <Section id="answers" eyebrow="Answers" title="Insurance ops questions, answered" tight>
    <ul class="check-list">
      <li><a href="/#in-network-50-states">How do I get my telehealth company in-network with insurance in all 50 states?</a></li>
      <li><a href="/solutions/virtual-care#when-to-accept">When should a virtual care company start accepting insurance?</a></li>
      <li><a href="/solutions/virtual-care#how-long">How long does it take a telehealth company to start accepting insurance?</a></li>
      <li><a href="/own-your-contracts#own-payer-contracts">How do I own my payer contracts instead of renting a network?</a></li>
      <li><a href="/own-your-contracts#rent-or-build">Should I rent a PC or build my own professional corporation?</a></li>
      <li><a href="/own-your-contracts#network-rental">What is network rental in telehealth, and what are the risks?</a></li>
      <li><a href="/platform/compliance#mso-pc">What is an MSO-PC structure and does my telehealth startup need one?</a></li>
      <li><a href="/solutions/switching#vendor-questions">What should a telehealth founder ask before signing with an insurance billing or network rental vendor?</a></li>
      <li><a href="/solutions/switching">How do I switch from a network rental vendor to my own payer contracts without losing revenue?</a></li>
      <li><a href="/pricing#credentialing-cost">How much does it cost to get a telehealth company credentialed and contracted with insurance payers?</a></li>
      <li><a href="/rates/code/90837">What are telehealth reimbursement rates for CPT 90837 by state?</a></li>
      <li><a href="/compare/bridge#bridge-alternatives">What are the best alternatives to Bridge for telehealth insurance billing?</a></li>
    </ul>
  </Section>
  <Section tight>
    {posts.length > 0 && (
      <div class="filters" role="tablist" aria-label="Filter by type">
        {cats.map((c, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-cat={c} class:list={['chip', { on: i === 0 }]}>{c}</button>)}
      </div>
    )}
    <div class="res-grid">
      <div class="res-main">
        {posts.length > 0 && (
          <>
            {featured && <div data-cat={featured.data.category}><ArticleCard post={featured} featured /></div>}
            <div class="grid grid-2" style="margin-top:20px">
              {rest.map((p) => <div data-cat={p.data.category}><ArticleCard post={p} /></div>)}
            </div>
            <p class="muted empty" hidden>No posts in this category yet.</p>
          </>
        )}
        {showHeld && octUpcoming.length > 0 && (
          <div class="card oct-tease">
            <h2>Scheduled for October</h2>
            <p class="muted">These guides are on the editorial calendar. This list is for preview only and is omitted from the live site.</p>
            <ul class="oct-list">
              {octUpcoming.map((p) => (
                <li>
                  {showHeld ? <a href={`/resources/${p.id}`}>{p.data.title}</a> : <span>{p.data.title}</span>}
                  <span class="muted small"> Scheduled {fmtDate(p.data.publishDate)}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <aside class="res-side">
        <NewsletterForm />
        <div class="card"><h3 style="font-size:18px">Tools</h3><ul class="tools"><li><a href="/rates">Rate lookup by state and code</a></li><li><a href="/pricing#calculator">Build vs partner calculator</a></li><li><a href="/platform/credentialing#idle-cost">Idle clinician cost counter</a></li><li><a href="/own-your-contracts#timeline">Ownership timeline</a></li><li><a href="/platform/contracting#coverage">Coverage map</a></li></ul></div>
      </aside>
    </div>
  </Section>
  <CtaBand />
</BaseLayout>
<style>
  .res-hero { padding: clamp(40px, 6vw, 72px) 0 8px; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
  .chip { font: inherit; font-size: 14px; font-weight: 500; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; }
  .chip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .res-grid { display: grid; grid-template-columns: 1fr 300px; gap: 40px; align-items: start; }
  .res-side { display: grid; gap: 16px; position: sticky; top: 90px; }
  .tools { list-style: none; padding: 0; margin: 0; }
  .tools li { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .tools li:last-child { border-bottom: 0; }
  .oct-tease { margin-top: 28px; }
  .oct-tease h2 { font-size: 22px; margin: 0 0 8px; }
  .oct-list { list-style: none; padding: 0; margin: 12px 0 0; }
  .oct-list li { padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .oct-list li:last-child { border-bottom: 0; }
  @media (max-width: 900px) { .res-grid { grid-template-columns: 1fr; } .res-side { position: static; } }
</style>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.res-main [data-cat]');
  const empty = document.querySelector<HTMLElement>('.empty');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-selected', 'false'); }); c.classList.add('on'); c.setAttribute('aria-selected', 'true');
    let n = 0; items.forEach((it) => { const show = c.dataset.cat === 'All' || it.dataset.cat === c.dataset.cat; it.hidden = !show; if (show) n++; });
    if (empty) empty.hidden = n > 0;
  }));
</script>
