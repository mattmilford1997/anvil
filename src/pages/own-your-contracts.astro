---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import TimelineSlider from '../components/TimelineSlider.astro';
import GatedDownload from '../components/GatedDownload.astro';
import Faq from '../components/Faq.astro';
import WedgeRelated from '../components/WedgeRelated.astro';
import CtaBand from '../components/CtaBand.astro';
import { ownFaqs } from '../data/faqs';
import { p02, p04, p14, ownInvolvesAnswer } from '../data/directAnswers';
import { absolute, breadcrumbJsonLd } from '../lib/seo';
import { lastmodFor } from '../data/lastmod.mjs';
import { getLivePost } from '../lib/content';
const rentOwn = await getLivePost('renting-vs-owning-professional-corporation');
const ownMeaning = ownFaqs.find((f) => f.q === 'What does it mean to own your payer contracts?');
const ownDefinition = ownMeaning ? `${ownMeaning.a.split('. ')[0]}.` : '';
const ownTitle = 'Own your payer contracts vs network rental';
const ownDescription = 'Own your payer contracts instead of network rental. Launch on our PC, then move to portable payer contracts your entity holds, with no revenue gap.';
const ownArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ownTitle,
  description: ownDescription,
  datePublished: '2026-09-15T00:00:00Z',
  dateModified: `${lastmodFor('/own-your-contracts')}T00:00:00Z`,
  author: { '@type': 'Organization', name: 'Anvil' },
  publisher: { '@type': 'Organization', name: 'Anvil', logo: { '@type': 'ImageObject', url: absolute('/logo.svg') } },
  mainEntityOfPage: absolute('/own-your-contracts'),
  image: absolute('/og-default-v2.png'),
  url: absolute('/own-your-contracts'),
};
const months = [
  ['Month 1', 'Your PC is formed in launch states. Physician owner matched. Clinicians roster-added under Anvil\'s contracts. You are billing.'],
  ['Months 1-4', 'Credentialing files built under your entity. Contract applications filed in your PC\'s name with your top payers.'],
  ['Months 4-8', 'First commercial contracts effective. New visits with those payers route to your PC. Claims in flight are unaffected.'],
  ['Months 8-12', 'Medicaid MCO and remaining commercial contracts land. Majority of volume on your own contracts. Platform fee steps down.'],
  ['Months 12-18', 'Steady state. Anvil runs RCM and renewals on contracts you own. Rental PC stays available for new states and closed panels.'],
];
---
<BaseLayout title={ownTitle} description={ownDescription} type="article" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: ownTitle, path: '/own-your-contracts' }]), ownArticle]}>
  <nav class="bridge-crumbs" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{ownTitle}</span></div>
  </nav>
  <Hero compact eyebrow="Own your contracts" title="Own your payer contracts. If your vendor owns them, you don't have insurance revenue. You have a lease." prompt="How do I own my payer contracts instead of renting a network?" promptId="own-payer-contracts" answer={p02} updated sub="Own your payer contracts instead of staying on network rental. Forward this to your board: what network rental vs owning contracts actually means, why rental is the right way to launch, and why it is the wrong place to stay." secondary={{ label: 'See pricing', href: '/pricing' }} />

  <Section id="definition" eyebrow="Definition" title="What does it mean to own your payer contracts?">
    <p class="lede">{ownDefinition}</p>
  </Section>

  <Section id="rent-or-build" eyebrow="Rent, then build" title="Rent a PC vs own a PC">
    <p class="lede">{p04}</p>
    <div class="grid grid-2">
      <div class="card"><h3>What renting is for</h3><p class="muted">Clinicians bill in weeks because the payer contracts already exist. The step is a roster-add, not a new contract negotiation.</p></div>
      <div class="card"><h3>What owning is for</h3><p class="muted">The participation agreements sit in your professional corporation. If you change vendors later, those contracts stay with your PC.</p></div>
    </div>
    <p>The roster-add does not wait on the new applications, so building does not delay the first insured visits. Already on a vendor? Read <a href="/solutions/switching">Switching from a network rental vendor</a>. Filing applications in that entity's name is <a href="/platform/contracting">payer contracting for telehealth</a>. Going from cash pay to those contracts is laid out in <a href="/resources/cash-pay-to-insurance-two-phase-plan">the cash-pay to insurance two-phase plan</a>.</p>
    <p>Published ranges for the codes you would contract are on <a href="/rates/code/90837">90837 reimbursement rates by state</a>.</p>
  </Section>

  <Section id="network-rental" eyebrow="Definition" title="What is network rental in telehealth, and what are the risks?">
    <p class="lede">{p14}</p>
    <p>This is different from a health plan leasing a PPO network, which is also called network rental. A care company being in-network with payers is a different idea, covered in <a href="/resources/what-in-network-nationally-means">what in-network nationally means</a>.</p>
  </Section>

  <Section eyebrow="The problem" title="Network rental is renting your revenue">
    <div class="grid grid-3">
      <div class="card"><h3>You never hold the contract</h3><p class="muted">The payer contracts, rates, and relationships sit in the vendor's entity. If you leave, you start from zero. Your entire insured revenue runs through a company you do not control.</p></div>
      <div class="card"><h3>You never see the rate</h3><p class="muted">You are paid a lease fee, not the contracted rate. You cannot negotiate with a payer. You cannot see the ladder. You cannot tell whether the fee is fair.</p></div>
      <div class="card"><h3>One vendor, one point of failure</h3><p class="muted">A payer terminating the vendor's group contract terminates every customer's coverage with that payer at once. That is concentration risk your investors will ask about.</p></div>
    </div>
    <p class="lede" style="margin-top:32px">Renting is still the fastest way to launch. The mistake is treating it as the destination. Read <a href="#rent-or-build">whether to rent a PC or build your own professional corporation</a>. If you are already on a vendor, start with <a href="/solutions/switching">Switching from a network rental vendor</a>. Compare that path on the <a href="/compare/bridge">Bridge alternative fact table</a>.</p>
  </Section>

  <Section id="how-to-own" eyebrow="The steps" title="What owning your payer contracts involves">
    <p class="lede">{ownInvolvesAnswer}</p>
    <ol class="own-steps">
      <li><strong>Bill on contracts that already exist.</strong> Roster-add clinicians to Anvil's PC so insured visits start in weeks. A roster-add is not a contract in your name. <a href="/resources/what-in-network-nationally-means">What in-network nationally means</a> separates a roster from a contract.</li>
      <li><strong>Form your professional corporation and place a physician owner.</strong> The PC is formed in the states you launch. A licensed physician owns it under a friendly-PC structure. This runs while you are already billing, so it does not delay the first insured visit.</li>
      <li><strong>File applications in that PC's name.</strong> Anvil prepares commercial and Medicaid applications, rate proposals, and redlines. You approve the terms. You see the published range before you sign and the executed rate after. Commercial contracts for a new PC commonly land in 4 to 8 months. Medicaid managed care varies by state. That filing is <a href="/platform/contracting">Payer contracting for telehealth, in your name</a>.</li>
      <li><strong>Move one payer at a time when its contract is effective.</strong> New visits with that payer bill under your PC. Claims already in flight stay with the entity that billed them. The platform fee steps down on the volume that moves, because Anvil is no longer carrying claims risk on it.</li>
      <li><strong>Keep the rented PC for what your contracts do not cover yet.</strong> Closed panels, new states, and payers still in process can stay on Anvil's PC. At steady state Anvil runs coding, claims, denials, and renewals on the contracts your PC holds. If you leave, those contracts stay with your PC.</li>
    </ol>
    <p>Clinicians are enrolled through <a href="/platform/credentialing">telehealth credentialing services</a>. The same sequence, when you are already on a vendor, is the <a href="/solutions/switching#switch-checklist">practical switching checklist</a>.</p>
  </Section>

  <Section eyebrow="The migration" title="How volume moves from our PC to yours" intro="Both tracks start on day one. Nothing about the migration gates your launch or interrupts billing.">
    <p class="lede">As volume moves, claims follow the entity through <a href="/platform/rcm">telehealth revenue cycle management</a>, and Medicaid MCO panels move the same way under <a href="/solutions/behavioral-health">behavioral health payer contracting</a>.</p>
    <div class="steps">
      {months.map(([when, what]) => (
        <div class="step reveal"><div class="when">{when}</div><p>{what}</p></div>
      ))}
    </div>
    <div style="margin-top:32px"><TimelineSlider /></div>
  </Section>

  <Section eyebrow="What you end up with" title="Portable payer contracts: an asset, not a dependency" tight>
    <ul class="check-list two-col">
      <li>Your own professional corporation in every state you operate</li>
      <li>A licensed physician owner under a friendly-PC structure</li>
      <li>Payer contracts in your entity's name, with portable payer contracts and billing under your own entity</li>
      <li>Credentialing files for every clinician, portable</li>
      <li>Reporting by payer, state, clinician, and code, under your entity</li>
    </ul>
  </Section>

  <Section eyebrow="Diligence" title="What investors ask, and what the answer should be">
    <div class="grid grid-2">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Question</th><th>On rental forever</th><th>After migration</th></tr></thead>
          <tbody>
            <tr><td>Does insured revenue run through an entity you control?</td><td class="muted">No</td><td>Yes</td></tr>
            <tr><td>Are payer contracts assignable in a sale?</td><td class="muted">There are none to assign</td><td>Yes, they are the company's</td></tr>
            <tr><td>Can a single vendor terminate network access?</td><td class="muted">Yes</td><td>No</td></tr>
            <tr><td>Do you know your contracted rates?</td><td class="muted">No, lease fee only</td><td>Yes, by payer and code</td></tr>
            <tr><td>What is the switching cost?</td><td class="muted">A relaunch</td><td>A vendor change</td></tr>
          </tbody>
        </table>
      </div>
      <GatedDownload name="diligence-checklist" title="Payer contract diligence checklist" body="The twelve questions we would ask any care company about its insurance revenue, with the answer that passes. Built for Series A and B diligence." cta="Send me the checklist" />
    </div>
  </Section>

  <Section eyebrow="Cost" title="Renting forever vs owning by year one" tight>
    <p class="lede">Rental fees do not step down. Ownership fees do. Run both on your numbers in the <a href="/pricing#calculator">calculator</a>{rentOwn && <>, or read the <a href={`/resources/${rentOwn.id}`}>full comparison</a></>}. See the <a href="/resources/five-workstreams-insurance-operations">cost of building insurance operations in-house</a>.</p>
    <p class="lede" style="margin-top:16px">Those five workstreams run on one <a href="/platform">insurance operations platform for care companies</a>.</p>
  </Section>

  <WedgeRelated current="/own-your-contracts" />
  <Section tight><Faq items={ownFaqs} /></Section>
  <CtaBand title="Rent for speed. Own for the asset. Start both today." body="Tell us your states and clinicians. We will map the migration month by month." primary={{ label: 'Get started', href: '/contact?src=own' }} secondary={{ label: 'See pricing', href: '/pricing' }} />
</BaseLayout>
<style>
  .own-steps { margin: 0; padding-left: 1.25em; display: grid; gap: 10px; max-width: 720px; }
  .own-steps li { padding-left: 0.35em; }
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; }
  .step .when { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .step p { margin: 0; font-size: 14.5px; color: var(--muted); }
  .two-col { columns: 2; column-gap: 32px; max-width: 900px; }
  .two-col li { break-inside: avoid; }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .steps, .two-col { grid-template-columns: 1fr; columns: 1; } }
</style>
