---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import WedgeRelated from '../../components/WedgeRelated.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { p01, p08, bridgeLeaveAnswer, bridgePriceAnswer } from '../../data/directAnswers';

const faqs = [
  {
    q: 'Who owns the payer contracts on Anvil vs on Bridge?',
    a: 'On Anvil, you launch on our contracted PC and we migrate volume to contracts in your entity\'s name. Bridge\'s homepage describes a 50-state PC and does not say who holds the payer contracts. If you never hold them, they are not an asset you can take with you.',
  },
  {
    q: 'Does Bridge use its own PC, and does Anvil use my own entity?',
    a: 'Bridge\'s homepage says it uses a 50-state PC. It does not say whether that PC is yours. Anvil uses a PC to launch, then forms your own PC, places a physician owner, and bills under your entity as each of your contracts becomes effective.',
  },
  {
    q: 'How does Anvil handle behavioral health compared with Bridge?',
    a: 'Anvil publishes a dedicated behavioral health path: Medicaid MCO panels, ABA authorizations, psychiatry credentialing across states, supervision billing, IOP and PHP, and collaborative care codes. Send us your license mix and we will walk it. Bridge\'s homepage cites 50+ specialties and its health plans page names behavioral health. Ask Bridge for its full specialty list if you are comparing coverage.',
  },
  {
    q: 'How do I switch from Bridge without a revenue gap?',
    a: 'Keep billing where you are. Form your PC, file contract applications in your name, and move volume payer by payer as each contract is effective. Give notice after the majority of volume is on your contracts. Remaining payers can run through Anvil\'s rented PC. Start on the switching page.',
  },
  {
    q: 'What are the best alternatives to Bridge for telehealth insurance billing?',
    a: p01,
  },
  {
    q: 'Bridge vs owning your own payer contracts: which is better for a virtual care company?',
    a: p08,
  },
  {
    q: 'What happens to my payer contracts if I leave a network rental vendor?',
    a: bridgeLeaveAnswer,
  },
  {
    q: 'How much does Bridge charge?',
    a: bridgePriceAnswer,
  },
  {
    q: 'How do CPOM and AKS show up in this comparison?',
    a: 'Anvil\'s rental phase is structured to align with the AKS personal services safe harbor. Your own PC is structured for each state\'s corporate practice of medicine rules, with an MSO-PC management agreement. That is the ownership path. Counsel reviews every Anvil structure.',
  },
];

const rows: [string, string[]][] = [
  ['Launch time', ['Weeks, by roster-add on our PC', 'As little as 30 days, on Bridge\'s homepage']],
  ['Professional corporation', ['Our PC to launch, then your own PC', '50-state PC, on Bridge\'s homepage']],
  ['Who holds the payer contracts', ['Moves to your entity', 'Not published']],
  ['Pricing', ['Platform fee on collections during rental, fixed PC fees', 'Not published']],
  ['Eligibility', ['Real-time insurance eligibility API at booking', 'Real-time eligibility and out-of-pocket estimates, on Bridge\'s homepage']],
  ['SOC 2', ['Type II in progress. HIPAA in place.', 'SOC 2 certified, on Bridge\'s homepage']],
  ['Claims risk', ['Anvil carries it during rental', 'No financial risk for claims and denials, on Bridge\'s homepage']],
  ['Specialties', ['Behavioral health payer contracting is published', '50+ specialties on Bridge\'s homepage. A full list is not published']],
  ['If you leave', ['Contracts are in your entity, so they stay with you', 'Not published']],
  ['Reimbursement rates', ['Parite ranges by state and CPT code', 'Not published']],
  ['MSO-PC and CPOM', ['MSO plus your own PC, papered for state CPOM', 'Not published']],
];
---
<BaseLayout
  title="Bridge alternative for virtual care billing"
  description="Compare Bridge and Anvil. Bridge's homepage describes a 50-state PC. Anvil is a Bridge alternative that migrates payer contracts into your name."
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Anvil vs Bridge', path: '/compare/bridge' }])]}
>
  <Hero
    compact
    eyebrow="Compare / Bridge"
    title="Bridge alternatives: launch fast, then own your payer contracts"
    prompt="What are the best alternatives to Bridge for telehealth insurance billing?"
    promptId="bridge-alternatives"
    answer={p01}
    sub="Anvil publishes the model: you launch on a rented PC, then migrate to contracts in your name."
    primary={{ label: 'Get started', href: '/contact?src=compare-bridge' }}
    secondary={{ label: 'How switching works', href: '/solutions/switching' }}
  />

  <Section id="bridge-vs-owning" eyebrow="Bridge vs owning" title="Bridge vs owning your own payer contracts: which is better?">
    <p class="lede">{p08}</p>
  </Section>

  <Section eyebrow="The difference" title="Bridge launches you on its PC. Anvil moves you to your own." intro="Bridge's homepage describes a 50-state PC model. Anvil also launches you on our PC, then moves volume to payer contracts your own entity holds. Rent, then own.">
    <ComparisonTable cols={['Anvil', 'Bridge']} rows={rows} highlight={false} />
    <p class="small muted" style="margin-top:16px">More on the Anvil side: <a href="/pricing">telehealth billing platform pricing</a>, <a href="/solutions/switching">switching without a revenue gap</a>, <a href="/rates">reimbursement rates by state and CPT code</a>, and the <a href="/platform/compliance#mso-pc">MSO-PC structure for telehealth</a>. Bridge cells are from the Bridge homepage at usebridge.com, reviewed October 2026, or marked Not published when that page does not state them. Specialties also uses Bridge's health plans page, which names urgent care, behavioral health, and cardiometabolic care and does not publish a full list.</p>
  </Section>

  <Section eyebrow="What the rows mean" title="Ownership, entity, behavioral health, and the switch">
    <div class="grid grid-2">
      <div class="card">
        <h3>You own the payer contracts</h3>
        <p class="muted">On Anvil, contracting for your entity runs in parallel with launch. As each contract is effective, new visits with that payer route to you. On a rental model, the vendor keeps the contracts, rates, and relationships. Read how to <a href="/own-your-contracts">own your payer contracts</a>, month by month.</p>
      </div>
      <div class="card">
        <h3>Rental PC vs your own entity</h3>
        <p class="muted">A rented PC is the fastest way to bill. It is the wrong place to stay. Anvil forms your professional corporation, places a physician owner, and papers the MSO-PC relationship for each state's CPOM rules. See <a href="/platform/compliance">CPOM and AKS compliance</a>.</p>
      </div>
      <div class="card">
        <h3>Behavioral health depth</h3>
        <p class="muted">Anvil is built for psychiatry, therapy, ABA, and IOP groups going from one state to many. Medicaid MCO panels, ABA authorizations, supervision billing, and collaborative care codes are the work. Start with <a href="/solutions/behavioral-health">behavioral health payer contracting</a>.</p>
      </div>
      <div class="card">
        <h3>The switching path</h3>
        <p class="muted">Do not give notice first. Collect credentialing files, form your PC, and file in your name. Move volume as contracts land. Anvil's rented PC can cover new states and closed panels during the switch. The playbook is on <a href="/solutions/switching">switching from a network rental vendor</a>.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="Who should switch" title="Who should switch from a network rental vendor">
    <p class="lede">Switch if you are at renewal, or an investor asked who holds the payer contracts, and those contracts are not in your entity. Keep billing where you are, form your PC, and move volume payer by payer. The steps are on <a href="/solutions/switching">switching from a network rental vendor</a>.</p>
  </Section>

  <WedgeRelated current="/compare/bridge" />

  <Section tight><Faq items={faqs} /></Section>
  <CtaBand
    title="Send us your current agreement. We will map the exit."
    body="Notice terms, which payers move first, and what you own when you are done. Bring your numbers. We will map them against published Anvil pricing."
    primary={{ label: 'Get started', href: '/contact?src=compare-bridge' }}
    secondary={{ label: 'See pricing', href: '/pricing' }}
  />
</BaseLayout>
