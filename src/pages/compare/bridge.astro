---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import WedgeRelated from '../../components/WedgeRelated.astro';
import SourcedCompareTable from '../../components/SourcedCompareTable.astro';
import { absolute, breadcrumbJsonLd } from '../../lib/seo';
import { lastmodFor } from '../../data/lastmod.mjs';
import { p01, p08, bridgeLeaveAnswer, bridgePriceAnswer, bridgeEmrApiAnswer, bridgeHealthPlansFactsAnswer } from '../../data/directAnswers';

const goodBridgeAlternative = 'Anvil is a Bridge alternative that launches clinicians in-network on a credentialed 50-state professional corporation, then moves volume to payer contracts in your entity\'s name. Bridge\'s homepage describes a 50-state PC and does not say who holds the payer contracts.';

const bridgeLivesAnswer = 'On a November 17, 2026 review, Bridge\'s homepage states 80% of commercially covered lives, 200M+ members, and real-time enrollment status tracking. It does not say who holds the payer contracts.';

const faqs = [
  {
    q: 'Who owns the payer contracts on Anvil vs on Bridge?',
    a: 'On Anvil, you launch on our contracted PC and we migrate volume to contracts in your entity\'s name. Bridge\'s homepage describes a 50-state PC and does not say who holds the payer contracts. If you never hold them, they are not an asset you can take with you.',
  },
  {
    q: 'Does Bridge use its own PC, and does Anvil use my own entity?',
    a: 'Bridge\'s homepage says it uses a 50-state PC. It does not say whether that PC is yours. Anvil uses a PC to launch, then forms your own PC, places a physician owner, and bills under your entity as each of your contracts becomes effective.',
  },
  {
    q: 'How does Anvil handle behavioral health compared with Bridge?',
    a: 'Anvil publishes a dedicated behavioral health path: Medicaid MCO panels, ABA authorizations, psychiatry credentialing across states, supervision billing, IOP and PHP, and collaborative care codes. Send us your license mix and we will walk it. Bridge\'s homepage cites 50+ specialties and its health plans page names behavioral health. Ask Bridge for its full specialty list if you are comparing coverage.',
  },
  {
    q: 'How do I switch from Bridge without a revenue gap?',
    a: 'Keep billing where you are. Form your PC, file contract applications in your name, and move volume payer by payer as each contract is effective. Give notice after the majority of volume is on your contracts. Remaining payers can run through Anvil\'s rented PC. Start on the switching page.',
  },
  {
    q: 'What are the best alternatives to Bridge for telehealth insurance billing?',
    a: p01,
  },
  {
    q: 'Bridge vs owning your own payer contracts: which is better for a virtual care company?',
    a: p08,
  },
  {
    q: 'What happens to my payer contracts if I leave a network rental vendor?',
    a: bridgeLeaveAnswer,
  },
  {
    q: 'How much does Bridge charge?',
    a: bridgePriceAnswer,
  },
  {
    q: 'What is a good Bridge alternative?',
    a: goodBridgeAlternative,
  },
  {
    q: 'What does Bridge\'s homepage say about covered lives and enrollment tracking?',
    a: bridgeLivesAnswer,
  },
  {
    q: 'What does Bridge\'s homepage say about EMR systems and APIs?',
    a: bridgeEmrApiAnswer,
  },
  {
    q: 'What does Bridge\'s health plans page say about its OIG opinion and appointment time?',
    a: bridgeHealthPlansFactsAnswer,
  },
];

const home = 'https://www.usebridge.com/';
const plans = 'https://www.usebridge.com/health-plans';
const bridgeHome = { href: home, label: 'usebridge.com homepage' };
const bridgePlans = { href: plans, label: 'usebridge.com health plans' };
const anvil = (href: string, label: string) => ({ href, label });
const rows = [
  { label: 'Launch time', cells: [
    { text: 'Weeks, by roster-add on our PC', sources: [anvil('/platform/credentialing', 'Anvil credentialing')] },
    { text: 'As little as 30 days, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Professional corporation', cells: [
    { text: 'Our PC to launch, then your own PC', sources: [anvil('/pricing', 'Anvil pricing')] },
    { text: '50-state PC, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Who holds the payer contracts', cells: [
    { text: 'Moves to your entity', sources: [anvil('/platform/contracting', 'Anvil contracting')] },
    { text: 'Not published', sources: [bridgeHome] },
  ]},
  { label: 'Pricing', cells: [
    { text: 'Platform fee on collections during rental, fixed PC fees', sources: [anvil('/pricing', 'Anvil pricing')] },
    { text: 'Not published', sources: [bridgeHome] },
  ]},
  { label: 'Eligibility', cells: [
    { text: 'Real-time insurance eligibility API at booking', sources: [anvil('/platform/eligibility', 'Anvil eligibility')] },
    { text: 'Real-time eligibility and out-of-pocket estimates, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'SOC 2', cells: [
    { text: 'Type II in progress. HIPAA in place.', sources: [anvil('/platform/compliance', 'Anvil compliance')] },
    { text: 'SOC 2 certified, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Claims risk', cells: [
    { text: 'Anvil carries it during rental', sources: [anvil('/pricing', 'Anvil pricing')] },
    { text: 'No financial risk for claims and denials, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Specialties', cells: [
    { text: 'Behavioral health payer contracting is published', sources: [anvil('/solutions/behavioral-health', 'Anvil behavioral health')] },
    { text: '50+ specialties on Bridge\'s homepage. A full list is not published', sources: [bridgeHome, bridgePlans] },
  ]},
  { label: 'Covered lives', cells: [
    { text: 'Not published', sources: [anvil('/pricing', 'Anvil pricing')] },
    { text: '80% of commercially covered lives and 200M+ members, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Enrollment tracking', cells: [
    { text: 'Every file tracked per clinician and per payer', sources: [anvil('/platform/compliance', 'Anvil compliance')] },
    { text: 'Real-time enrollment status tracking, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'EMR compatibility', cells: [
    { text: 'Not published', sources: [anvil('/platform', 'Anvil platform')] },
    { text: 'Compatible with any EMR system, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Developer APIs', cells: [
    { text: 'Eligibility API and a hosted widget', sources: [anvil('/platform/eligibility', 'Anvil eligibility')] },
    { text: 'Developer friendly with easy to integrate APIs, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'Contract-level logic', cells: [
    { text: 'Not published', sources: [anvil('/platform/eligibility', 'Anvil eligibility')] },
    { text: 'Contract-level logic verification, on Bridge\'s homepage', sources: [bridgeHome] },
  ]},
  { label: 'OIG advisory opinion', cells: [
    { text: 'No OIG advisory opinion is claimed', sources: [anvil('/platform/compliance', 'Anvil compliance')] },
    { text: 'Favorable OIG opinion No. 25-03, on Bridge\'s health plans page', sources: [bridgePlans] },
  ]},
  { label: 'Time to appointment', cells: [
    { text: 'Not published', sources: [anvil('/platform', 'Anvil platform')] },
    { text: 'Average time to appointment is 5 days, on Bridge\'s health plans page', sources: [bridgePlans] },
  ]},
  { label: 'If you leave', cells: [
    { text: 'Contracts are in your entity, so they stay with you', sources: [anvil('/own-your-contracts', 'Anvil own your contracts')] },
    { text: 'Not published', sources: [bridgeHome] },
  ]},
  { label: 'Reimbursement rates', cells: [
    { text: 'Parite ranges by state and CPT code', sources: [anvil('/rates', 'Anvil rates')] },
    { text: 'Not published', sources: [bridgeHome] },
  ]},
  { label: 'Multi-state contract time', cells: [
    { text: 'Not published', sources: [anvil('/platform/contracting#in-network-timeline', 'Anvil contracting timeline')] },
    { text: '6 to 12 months to secure multi-state contracts, as Bridge published it. Longer if starting from scratch.', sources: [{ href: 'https://www.usebridge.com/resources/build-vs-partner', label: 'usebridge.com, build vs partner' }] },
  ]},
  { label: 'In-house operations cost', cells: [
    { text: 'Not published', sources: [anvil('/pricing', 'Anvil pricing')] },
    { text: '20 to 25% of gross revenue at steady state, as Bridge published it.', sources: [{ href: 'https://www.usebridge.com/resources/building-insurance-operations-in-house', label: 'usebridge.com, in-house operations math' }] },
  ]},
];
const bridgeTitle = 'Bridge alternative for telehealth insurance billing';
const bridgeDescription = 'Looking for a Bridge alternative? Compare Bridge with Anvil, which migrates payer contracts into your own entity\'s name.';
const bridgeArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: bridgeTitle,
  description: bridgeDescription,
  datePublished: '2026-09-15T00:00:00Z',
  dateModified: `${lastmodFor('/compare/bridge')}T00:00:00Z`,
  author: { '@type': 'Organization', name: 'Anvil' },
  publisher: { '@type': 'Organization', name: 'Anvil', logo: { '@type': 'ImageObject', url: absolute('/logo.svg') } },
  mainEntityOfPage: absolute('/compare/bridge'),
  image: absolute('/og-default-v2.png'),
  url: absolute('/compare/bridge'),
};
---
<BaseLayout
  title={bridgeTitle}
  description={bridgeDescription}
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Anvil vs Bridge', path: '/compare/bridge' }]), bridgeArticle]}
>
  <nav class="bridge-crumbs" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a> <span aria-hidden="true">/</span> Anvil vs Bridge</div>
  </nav>
  <Hero
    compact
    foldCta
    eyebrow="Compare / Bridge"
    title="Bridge alternative: launch fast, then own your payer contracts"
    prompt="What are the best alternatives to Bridge for telehealth insurance billing?"
    promptId="bridge-alternatives"
    answer={p01}
    updated
    sub="Anvil publishes the model next to Bridge (usebridge.com): you launch on a rented PC, then migrate to contracts in your name."
    primary={{ label: 'Get started', href: '/contact?src=compare-bridge' }}
    secondary={{ label: 'How switching works', href: '/solutions/switching' }}
  />

  <Section id="bridge-vs-owning" eyebrow="Bridge vs owning" title="Bridge vs owning your own payer contracts: which is better?">
    <p class="lede">{p08}</p>
  </Section>

  <Section id="bridge-sourced" eyebrow="The difference" title="Bridge launches you on its PC. Anvil moves you to your own." intro="Bridge's homepage describes a 50-state PC model. Anvil also launches you on our PC, then moves volume to payer contracts your own entity holds. Rent, then own.">
    <p class="lede">Written by Anvil. Bridge cells are quoted from the cited usebridge.com pages, checked November 17, 2026. Anvil cells are quoted from the cited Anvil pages, checked on the same date. Where a site does not publish a figure, the cell says Not published. This is not a scored ranking.</p>
    <SourcedCompareTable cols={['Anvil', 'Bridge']} rows={rows} />
    <p class="lede" style="margin-top:16px">On claims and billing, Anvil runs <a href="/platform/rcm">telehealth revenue cycle management</a> and carries claims risk during rental. Clinicians go live by roster-add through <a href="/platform/credentialing">telehealth credentialing services</a>. Why a roster-add is not a contract of your own is covered in <a href="/resources/what-in-network-nationally-means">what in-network nationally means</a>. Eligibility checks run on a <a href="/platform/eligibility">real-time insurance eligibility API</a> at booking. Those run on one <a href="/platform">insurance operations platform</a>, alongside payer contracting and compliance.</p>
    <p class="lede" style="margin-top:16px">{bridgeLivesAnswer}</p>
    <p class="small muted" style="margin-top:16px">More on the Anvil side: <a href="/pricing">telehealth billing platform pricing</a>, <a href="/solutions/switching">switching without a revenue gap</a>, and <a href="/rates">reimbursement rates by state and CPT code</a>. Bridge's <a href="https://www.usebridge.com/health-plans" rel="noopener" target="_blank">health plans page</a> names urgent care, behavioral health, and cardiometabolic care, and it does not publish a full specialty list. Checked November 17, 2026.</p>
  </Section>

  <Section eyebrow="What the rows mean" title="Ownership, entity, behavioral health, and the switch">
    <div class="grid grid-2">
      <div class="card">
        <h3>You own the payer contracts</h3>
        <p class="muted">On Anvil, contracting for your entity runs in parallel with launch. As each contract is effective, new visits with that payer route to you. On a rental model, the vendor keeps the contracts, rates, and relationships. Getting contracts in your own entity's name is <a href="/platform/contracting">payer contracting for telehealth</a>. Read how to <a href="/own-your-contracts">own your payer contracts</a>, month by month.</p>
      </div>
      <div class="card">
        <h3>Rental PC vs your own entity</h3>
        <p class="muted">A rented PC is the fastest way to bill. It is the wrong place to stay. Anvil forms your professional corporation, and places a physician owner.</p>
      </div>
      <div class="card">
        <h3>Behavioral health depth</h3>
        <p class="muted">Anvil is built for psychiatry, therapy, ABA, and IOP groups going from one state to many. Medicaid MCO panels, ABA authorizations, supervision billing, and collaborative care codes are the work. Start with <a href="/solutions/behavioral-health">behavioral health payer contracting</a>. Anvil also bills visits off the screen through <a href="/solutions/hybrid-care">in-home care insurance billing</a>. What payers publish for 60-minute psychotherapy is on <a href="/rates/code/90837">90837 reimbursement rates by state</a>. Medicaid ranges by state are on <a href="/rates/payer/medicaid">Medicaid psychotherapy rates by state (2026)</a>.</p>
      </div>
      <div class="card">
        <h3>Who should switch</h3>
        <p class="muted">Switch if you are at renewal, or an investor asked who holds the payer contracts, and those contracts are not in your entity. Do not give notice first. Keep billing where you are, form your PC, and move volume payer by payer. The steps are on <a href="/solutions/switching">switching from a network rental vendor</a>.</p>
      </div>
    </div>
    <p class="lede" style="margin-top:24px">Anvil is <a href="/">insurance billing infrastructure for virtual care</a>. The launch choice is <a href="/own-your-contracts#rent-or-build">rent a PC vs own a PC</a>. If you bill cash-pay today, start with the <a href="/resources/cash-pay-to-insurance-two-phase-plan">Cash-Pay to Insurance Transition Telehealth: The Two-Phase Plan</a>.</p>
  </Section>

  <WedgeRelated current="/compare/bridge" />

  <Section tight><Faq items={faqs} /></Section>
  <CtaBand
    title="Send us your current agreement. We will map the exit."
    body="Notice terms, which payers move first, and what you own when you are done. Bring your numbers. We will map them against published Anvil pricing."
    primary={{ label: 'Get started', href: '/contact?src=compare-bridge' }}
    secondary={{ label: 'See pricing', href: '/pricing' }}
  />
</BaseLayout>
