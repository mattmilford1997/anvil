---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../../site.config.mjs';
---
<BaseLayout title="Careers in insurance ops for care companies" description="Join Anvil building insurance infrastructure for care companies. Remote, US. Payer contracting, credentialing, and engineering.">
  <Hero compact eyebrow="Careers" title="Do the work that makes care companies possible." sub="Small team, operator culture, regulated business. We publish our pricing and our playbook. We expect the same directness inside." primary={{ label: 'Introduce yourself', href: '/contact?src=careers' }} />
  <Section eyebrow="Open roles" tight>
    <p class="lede">Open roles publish here as we hire. If you do not see a fit, <a href="/contact?src=careers">introduce yourself</a> or email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
  </Section>
  <CtaBand title="Don't see your role?" body="Tell us what you would build or run here." primary={{ label: 'Introduce yourself', href: '/contact?src=careers' }} secondary={undefined} />
</BaseLayout>
