---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import RateRelated from '../../../components/RateRelated.astro';
import { breadcrumbJsonLd } from '../../../lib/seo';
import {
  codesInData,
  pairsForCode,
  stateName,
  codeServiceName,
  payerNamesInRows,
  joinLabels,
  ratePath,
  stateHubPath,
  payerHubPath,
  payerHubsForRows,
  payerHubLinkLabel,
  codeHubPath,
  codeHubTitle,
  codeHubH1,
  codeHubDescription,
  fmtRate,
  fmtRange,
  payerCodeSpread,
  codePayerCoverageSentence,
} from '../../../lib/rates';

export function getStaticPaths() {
  return codesInData().map((code) => ({ params: { code }, props: { code } }));
}

const { code } = Astro.props;
const pairs = pairsForCode(code);
const payerPhrase = joinLabels(payerNamesInRows(pairs.flatMap((p) => p.rows)));
const medicaidPairs = pairs.flatMap((p) => {
  const row = p.rows.find((r) => r.payer === 'medicaid-ffs');
  if (!row) return [];
  const range = row.low === row.high ? fmtRate(row.low) : `${fmtRate(row.low)} to ${fmtRate(row.high)}`;
  return [{ state: p.state, range }];
});
const medicaidOnly = medicaidPairs.length > 0 && pairs.every((p) => p.rows.every((r) => r.payer === 'medicaid-ffs'));
const title = codeHubTitle(code);
const h1 = codeHubH1(code);
const description = codeHubDescription(code);
const path = codeHubPath(code);
const payerHubLinks = payerHubsForRows(pairs.flatMap((pair) => pair.rows));
const medicareSpread = code === '90791' || code === '90834' ? payerCodeSpread('medicare', code) : undefined;
const medicaid97153 = code === '97153' ? payerCodeSpread('medicaid-ffs', '97153') : undefined;
const medicaid90834 = code === '90834' ? payerCodeSpread('medicaid-ffs', '90834') : undefined;
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Rates', path: '/rates' },
    { name: h1, path },
  ])]}
>
  <section class="rate-head">
    <div class="container">
      <div class="eyebrow">Rates / {code}</div>
      <h1>{h1}</h1>
      <p class="lede">{code} ({codeServiceName(code)}) reimbursement rates by state are {payerPhrase} ranges from Parite, for the payers published in each state. These are planning ranges, not a guarantee of what you will be paid. Use them when you <a href="/own-your-contracts">own your payer contracts</a>.</p>
      <p class="lede" style="margin-top:16px">{codePayerCoverageSentence(code)}</p>
      {medicareSpread && (
        <p class="lede" style="margin-top:16px">Across the {medicareSpread.n} {medicareSpread.noun} with a published Medicare {code} range, the highest is in <a href={ratePath(medicareSpread.highest.state, code)}>{stateName(medicareSpread.highest.state)}</a> ({fmtRange(medicareSpread.highest.low, medicareSpread.highest.high)}) and the lowest in <a href={ratePath(medicareSpread.lowest.state, code)}>{stateName(medicareSpread.lowest.state)}</a> ({fmtRange(medicareSpread.lowest.low, medicareSpread.lowest.high)}).</p>
      )}
      {medicaid97153 && (
        <p class="lede" style="margin-top:16px">Across the {medicaid97153.n} {medicaid97153.noun} with a published Medicaid FFS 97153 range, the highest is in <a href={ratePath(medicaid97153.highest.state, '97153')}>{stateName(medicaid97153.highest.state)}</a> ({fmtRange(medicaid97153.highest.low, medicaid97153.highest.high)}) and the lowest in <a href={ratePath(medicaid97153.lowest.state, '97153')}>{stateName(medicaid97153.lowest.state)}</a> ({fmtRange(medicaid97153.lowest.low, medicaid97153.lowest.high)}).</p>
      )}
      {medicaid90834 && (
        <p class="lede" style="margin-top:16px">Across the {medicaid90834.n} {medicaid90834.noun} with a published Medicaid FFS 90834 range, the highest is in <a href={ratePath(medicaid90834.highest.state, '90834')}>{stateName(medicaid90834.highest.state)}</a> ({fmtRange(medicaid90834.highest.low, medicaid90834.highest.high)}) and the lowest in <a href={ratePath(medicaid90834.lowest.state, '90834')}>{stateName(medicaid90834.lowest.state)}</a> ({fmtRange(medicaid90834.lowest.low, medicaid90834.lowest.high)}).</p>
      )}
      {payerHubLinks.length > 0 && (
        <p class="lede">
          Payer {payerHubLinks.length === 1 ? 'hub' : 'hubs'}:{' '}
          {payerHubLinks.map((hub, i) => (
            <>
              {i === 0 ? '' : i === payerHubLinks.length - 1 ? (payerHubLinks.length === 2 ? ' and ' : ', and ') : ', '}
              <a href={payerHubPath(hub.payer)}>{payerHubLinkLabel[hub.payer]}</a>
            </>
          ))}
          .
        </p>
      )}
      <p class="small muted"><a href="/rates">All reimbursement rates by state and CPT code</a></p>
    </div>
  </section>
  <Section id="telehealth-rates-by-state" eyebrow="Telehealth" title={`CPT ${code} telehealth reimbursement rates by state`}>
    <p class="lede">CPT {code} telehealth reimbursement rates by state are {payerPhrase} ranges from Parite, for the payers published in each state.</p>
  </Section>
  {medicaidPairs.length > 0 && (
    <Section eyebrow="Medicaid" title={`Medicaid ${code} reimbursement rate by state`}>
      {!medicaidOnly && <p class="lede">Medicaid FFS ranges Parite publishes for {code}. Planning ranges, not a guarantee of payment.</p>}
      <ul class="check-list">
        {medicaidPairs.map((p) => (
          <li>
            <a href={ratePath(p.state, code)}>{stateName(p.state)}</a>
            <span class="muted">: {p.range}</span>
          </li>
        ))}
      </ul>
    </Section>
  )}
  <Section eyebrow="States" title={`States with a published ${code} range`} tight>
    <ul class="check-list">
      {pairs.map((p) => (
        <li>
          <a href={ratePath(p.state, p.code)}>{p.code} reimbursement rate in {stateName(p.state)} by payer (2026)</a>
          <span class="muted">. <a href={stateHubPath(p.state)}>{stateName(p.state)} therapy reimbursement rates by CPT code</a>.</span>
        </li>
      ))}
    </ul>
  </Section>
  <Section eyebrow="Other codes" title="Reimbursement rates by state for other CPT codes" tight>
    <ul class="check-list">
      {codesInData().filter((c) => c !== code).map((c) => (
        <li><a href={codeHubPath(c)}>{c} reimbursement rates by state</a><span class="muted">, {codeServiceName(c)}</span></li>
      ))}
    </ul>
  </Section>
  <RateRelated />
  <CtaBand
    title="Know the rate. Then get the contract."
    body="Send us your codes and states. We come back with payer order, timelines, and the ranges to plan on."
    primary={{ label: 'Get a contracting plan', href: '/contact?src=rates-code' }}
    secondary={{ label: 'Rates hub', href: '/rates' }}
  />
</BaseLayout>
<style>
  .rate-head { padding: clamp(40px, 6vw, 72px) 0 8px; }
  .rate-head h1 { max-width: 22ch; font-size: clamp(28px, 4.4vw, 44px); }
</style>
