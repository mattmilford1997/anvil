---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import RateRelated from '../../../components/RateRelated.astro';
import { breadcrumbJsonLd } from '../../../lib/seo';
import {
  ratesByJurisdiction,
  ratePath,
  codeLabel,
  payerNamesInRows,
  joinLabels,
  fmtRate,
  stateHubPath,
  stateHubTitle,
  stateHubH1,
  stateHubDescription,
  codeHubPath,
  nearbyHubs,
} from '../../../lib/rates';

export function getStaticPaths() {
  return ratesByJurisdiction().map((jurisdiction) => ({
    params: { state: jurisdiction.state.toLowerCase() },
    props: { jurisdiction },
  }));
}

const { jurisdiction } = Astro.props;
const { name, state, pairs } = jurisdiction;
const payerPhrase = joinLabels(payerNamesInRows(pairs.flatMap((p) => p.rows)));
const codePayerPhrases = pairs.map((p) => ({ code: p.code, phrase: joinLabels(payerNamesInRows(p.rows)) }));
const samePayers = new Set(codePayerPhrases.map((c) => c.phrase)).size <= 1;
const smaller = codePayerPhrases.filter((c) => c.phrase !== payerPhrase);
const varyClause = smaller.length === 0
  ? ''
  : smaller.length === 1
    ? `${smaller[0].code} has ${smaller[0].phrase} only`
    : `${smaller.slice(0, -1).map((c) => `${c.code} has ${c.phrase} only`).join(', ')}, and ${smaller[smaller.length - 1].code} has ${smaller[smaller.length - 1].phrase} only`;
const rateLede = samePayers
  ? `${name} therapy reimbursement rates by CPT code are Parite ranges from ${payerPhrase}.`
  : `${name} therapy reimbursement rates by CPT code are Parite ranges from ${payerPhrase}. Payers vary by code: ${varyClause}.`;
const title = stateHubTitle(name);
const h1 = stateHubH1(name);
const description = stateHubDescription(name);
const path = stateHubPath(state);
const neighbors = nearbyHubs(state);
const psychCodes = ['90791', '90834', '90837'];
const psychPairs = pairs.filter((p) => psychCodes.includes(p.code));
const psychCodeList = joinLabels(psychPairs.map((p) => p.code));
const psychPayers = joinLabels(payerNamesInRows(psychPairs.flatMap((p) => p.rows)));
const medicaid90837 = pairs.find((p) => p.code === '90837')?.rows.find((r) => r.payer === 'medicaid-ffs');
const medicaid90837Range = medicaid90837
  ? (medicaid90837.low === medicaid90837.high
    ? fmtRate(medicaid90837.low)
    : `${fmtRate(medicaid90837.low)} to ${fmtRate(medicaid90837.high)}`)
  : '';
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Rates', path: '/rates' },
    { name: h1, path },
  ])]}
>
  <section class="rate-head">
    <div class="container">
      <div class="eyebrow">Rates / {name}</div>
      <h1>{h1}</h1>
      <p class="lede">{rateLede} These are planning ranges, not a guarantee of what you will be paid. Use them when you <a href="/own-your-contracts">own your payer contracts</a>.</p>
      <p class="small muted"><a href="/rates">All reimbursement rates by state and CPT code</a></p>
    </div>
  </section>
  {psychPairs.length > 0 && (
    <Section id="psychotherapy-rates" eyebrow="Psychotherapy" title={`${name} psychotherapy reimbursement rates`}>
      <p class="lede">Parite published ranges for {psychCodeList} in {name}. Published ranges come from {psychPayers}.</p>
    </Section>
  )}
  {medicaid90837 && (
    <Section id="medicaid-90837" eyebrow="Medicaid" title={`Medicaid 90837 range in ${name}`}>
      <p class="lede">Parite lists Medicaid FFS for 90837 in {name} at {medicaid90837Range} per unit. See the <a href={ratePath(state, '90837')}>90837 reimbursement rate in {name} by payer</a>.</p>
    </Section>
  )}
  <Section eyebrow="CPT codes" title={`CPT codes with published ranges in ${name}`} tight>
    <ul class="check-list">
      {pairs.map((p) => (
        <li>
          <a href={ratePath(p.state, p.code)}>{p.code} reimbursement rate in {name} by payer (2026)</a>
          <span class="muted">. {codeLabel(p.code)}. Also see <a href={codeHubPath(p.code)}>{p.code} reimbursement rates by state</a>.</span>
        </li>
      ))}
    </ul>
  </Section>
  {neighbors.length > 0 && (
    <Section title="Rates in nearby states" tight>
      <ul class="check-list">
        {neighbors.map((j) => <li><a href={stateHubPath(j.state)}>{j.name}</a></li>)}
      </ul>
    </Section>
  )}
  <RateRelated />
  <CtaBand
    title="Know the rate. Then get the contract."
    body="Send us your codes and states. We come back with payer order, timelines, and the ranges to plan on."
    primary={{ label: 'Get a contracting plan', href: '/contact?src=rates-state' }}
    secondary={{ label: 'Rates hub', href: '/rates' }}
  />
</BaseLayout>
<style>
  .rate-head { padding: clamp(40px, 6vw, 72px) 0 8px; }
  .rate-head h1 { max-width: 22ch; font-size: clamp(28px, 4.4vw, 44px); }
</style>
