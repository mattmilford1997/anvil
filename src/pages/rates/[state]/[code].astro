---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { breadcrumbJsonLd } from '../../../lib/seo';
import {
  ratePairs,
  stateName,
  codeLabel,
  codeServiceName,
  payerLabel,
  fmtRate,
  ratePath,
  sourcesOnPage,
  ratesFile,
  ratePageTitle,
  ratePageDescription,
  ratePageH1,
} from '../../../lib/rates';

export function getStaticPaths() {
  return ratePairs().map(({ state, code, rows }) => ({
    params: { state: state.toLowerCase(), code },
    props: { rows, stateUpper: state },
  }));
}

const { rows, stateUpper } = Astro.props;
const { code } = Astro.params;
const name = stateName(stateUpper);
const h1 = ratePageH1(code, name);
const title = ratePageTitle(code, name);
const description = ratePageDescription(code, name);
const lows = rows.map((r) => r.low);
const highs = rows.map((r) => r.high);
const blendLow = Math.min(...lows);
const blendHigh = Math.max(...highs);
const payers = rows.map((r) => payerLabel(r.payer));
const sources = sourcesOnPage(rows);
const hasMedicaid = rows.some((r) => r.payer === 'medicaid-ffs');
const bhCodes = new Set(['90791', '90834', '90837', '97153']);
const siblingCodes = ratePairs()
  .filter((p) => p.state === stateUpper && p.code !== code)
  .map((p) => p.code);
const payerList = payers.length <= 1 ? (payers[0] ?? '') : payers.length === 2 ? `${payers[0]} and ${payers[1]}` : `${payers.slice(0, -1).join(', ')}, and ${payers[payers.length - 1]}`;
const service = codeServiceName(code);
const rangeSentence = fmtRate(blendLow) === fmtRate(blendHigh)
  ? `The ${code} reimbursement rate in ${name} (${service}) is ${fmtRate(blendLow)} per unit from ${payerList}, before patient responsibility.`
  : `The ${code} reimbursement rate in ${name} (${service}) ranges from ${fmtRate(blendLow)} to ${fmtRate(blendHigh)} per unit across ${payerList}, before patient responsibility.`;
const intro = `${rangeSentence} These are Parite ranges for planning, not a guarantee of what you will be paid.`;
---
<BaseLayout
  title={title}
  exactTitle
  description={description}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Rates', path: '/rates' },
    { name: `${code} in ${name}`, path: ratePath(stateUpper, code) },
  ])]}
>
  <section class="rate-head">
    <div class="container">
      <div class="eyebrow">Rates / {name} / {code}</div>
      <h1>{h1}</h1>
      <p class="lede">{intro}</p>
      <p class="small muted"><a href="/rates">All reimbursement rates by state and CPT code</a></p>
    </div>
  </section>

  <Section eyebrow="By payer" title={`Telehealth reimbursement by payer for ${code} in ${name}`} tight>
    {hasMedicaid && <h2 class="med-h">Medicaid reimbursement rate for {code} in {name}</h2>}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Payer</th>
            <th>Low</th>
            <th>High</th>
            <th>Median</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{payerLabel(r.payer)}</td>
              <td>{fmtRate(r.low)}</td>
              <td>{fmtRate(r.high)}</td>
              <td>{r.median != null ? fmtRate(r.median) : 'n/a'}</td>
              <td class="src">{r.source}{r.effectiveFrom ? ` · effective ${r.effectiveFrom}` : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted" style="margin-top:12px">
      Source: {ratesFile.source ?? 'Parite'}. Updated {ratesFile.updated}.
      {sources.length > 0 && <> Labels as Parite provides them: {sources.join('; ')}.</>}
      {' '}Not a contracted rate for your entity and not a guarantee.
    </p>
  </Section>

  {siblingCodes.length > 0 && (
    <Section eyebrow="Same state" title={`Other ${name} codes`} tight>
      <ul class="check-list">
        {siblingCodes.map((c) => (
          <li><a href={ratePath(stateUpper, c)}>{c} reimbursement rate in {name} by payer (2026)</a>, {codeLabel(c)}</li>
        ))}
      </ul>
    </Section>
  )}

  <Section tight>
    <p class="lede">Rates are negotiated, not fixed. See <a href="/platform/contracting">payer contracting for telehealth</a>, how to <a href="/own-your-contracts">own your payer contracts</a>{bhCodes.has(code) && <>, and <a href="/solutions/behavioral-health">behavioral health payer contracting</a></>}. Comparing vendors? See the <a href="/compare/bridge">Bridge alternative</a> fact table. <a href="/rates#all-states">Same code in other states</a>.</p>
  </Section>

  <CtaBand
    title="Know the rate. Then get the contract."
    body="Send us your codes and states. We come back with payer order, timelines, and the ranges to plan on."
    primary={{ label: 'Get a contracting plan', href: '/contact?src=rates-page' }}
    secondary={{ label: 'Rates hub', href: '/rates' }}
  />
</BaseLayout>
<style>
  .rate-head { padding: clamp(40px, 6vw, 72px) 0 8px; }
  .rate-head h1 { max-width: 24ch; font-size: clamp(28px, 4.4vw, 44px); }
  .med-h { font-size: clamp(22px, 2.6vw, 28px); margin: 8px 0 16px; }
  .src { font-size: 13.5px; color: var(--muted); }
</style>
