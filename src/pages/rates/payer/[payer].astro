---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { breadcrumbJsonLd } from '../../../lib/seo';
import {
  payerHubs,
  payerHubBySlug,
  rowsForPayer,
  stateName,
  fmtRate,
  fmtRange,
  ratePath,
  shortPayerName,
  payerCodeSpread,
  placeNoun,
  codeHubH1,
  codeHubPath,
  medicaidAboveUhc,
} from '../../../lib/rates';

export function getStaticPaths() {
  return payerHubs.map((hub) => ({ params: { payer: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const found = payerHubBySlug(hub.slug);
if (!found) throw new Error(`Missing payer hub ${hub.slug}`);
const rows = rowsForPayer(hub.payer);
const who = shortPayerName(hub.payer);
const payerName = hub.payer === 'medicaid-ffs' ? 'Medicaid' : who;
const abaLine = hub.slug === 'medicaid' ? ' 97153 appears only where Parite publishes it.' : '';
const intro = `${payerName} reimbursement rates by state and CPT code, from Parite, including the ${payerName} 90837 rate in every state Parite covers.${abaLine} These are planning ranges, not a guarantee of payment.`;
const spread = payerCodeSpread(hub.payer, '90837');
const medicare90791 = hub.payer === 'medicare' ? payerCodeSpread('medicare', '90791') : undefined;
const medicare90834 = hub.payer === 'medicare' ? payerCodeSpread('medicare', '90834') : undefined;
const uhc90791 = hub.payer === 'uhc' ? payerCodeSpread('uhc', '90791') : undefined;
const medicaid90791 = hub.payer === 'medicaid-ffs' ? payerCodeSpread('medicaid-ffs', '90791') : undefined;
const medicaid90834 = hub.payer === 'medicaid-ffs' ? payerCodeSpread('medicaid-ffs', '90834') : undefined;
const medicaid97153 = hub.payer === 'medicaid-ffs' ? payerCodeSpread('medicaid-ffs', '97153') : undefined;
const uhc90834 = hub.payer === 'uhc' ? payerCodeSpread('uhc', '90834') : undefined;
const places = [...new Set(rows.map((row) => row.state))];
const codeCount = new Set(rows.map((row) => row.code)).size;
const codeHubCodes = hub.payer === 'medicaid-ffs' ? ['90837', '90834', '90791', '97153'] : ['90837', '90834', '90791'];
const mediUhc90791 = medicaidAboveUhc('90791');
const mediUhc90834 = medicaidAboveUhc('90834');
const mediUhc90837 = medicaidAboveUhc('90837');
---
<BaseLayout
  title={hub.title}
  description={hub.description}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Rates', path: '/rates' },
    { name: hub.h1, path: `/rates/payer/${hub.slug}` },
  ])]}
>
  <section class="rate-head">
    <div class="container">
      <div class="eyebrow">Rates / {who}</div>
      <h1>{hub.h1}</h1>
      <p class="lede">{intro}</p>
      <p class="lede" style="margin-top:16px">This table has {rows.length} {who} ranges across {places.length} {placeNoun(places, places.length)} and {codeCount} CPT codes.</p>
      {spread && (
        <p class="lede">Among the {spread.n} {spread.noun} Parite publishes {spread.payerName} 90837 for, the highest range is in <a href={ratePath(spread.highest.state, '90837')}>{stateName(spread.highest.state)}</a> ({fmtRange(spread.highest.low, spread.highest.high)}) and the lowest is in <a href={ratePath(spread.lowest.state, '90837')}>{stateName(spread.lowest.state)}</a> ({fmtRange(spread.lowest.low, spread.lowest.high)}).</p>
      )}
      {medicare90791 && (
        <p class="lede" style="margin-top:16px">For 90791, the highest Medicare range is in <a href={ratePath(medicare90791.highest.state, '90791')}>{stateName(medicare90791.highest.state)}</a> ({fmtRange(medicare90791.highest.low, medicare90791.highest.high)}) and the lowest is in <a href={ratePath(medicare90791.lowest.state, '90791')}>{stateName(medicare90791.lowest.state)}</a> ({fmtRange(medicare90791.lowest.low, medicare90791.lowest.high)}), across {medicare90791.n} {medicare90791.noun}.</p>
      )}
      {medicare90834 && (
        <p class="lede" style="margin-top:16px">For 90834, the highest Medicare range is in <a href={ratePath(medicare90834.highest.state, '90834')}>{stateName(medicare90834.highest.state)}</a> ({fmtRange(medicare90834.highest.low, medicare90834.highest.high)}) and the lowest is in <a href={ratePath(medicare90834.lowest.state, '90834')}>{stateName(medicare90834.lowest.state)}</a> ({fmtRange(medicare90834.lowest.low, medicare90834.lowest.high)}), across {medicare90834.n} {medicare90834.noun}.</p>
      )}
      {medicaid90791 && (
        <p class="lede" style="margin-top:16px">For 90791, the highest Medicaid range is in <a href={ratePath(medicaid90791.highest.state, '90791')}>{stateName(medicaid90791.highest.state)}</a> ({fmtRange(medicaid90791.highest.low, medicaid90791.highest.high)}) and the lowest is in <a href={ratePath(medicaid90791.lowest.state, '90791')}>{stateName(medicaid90791.lowest.state)}</a> ({fmtRange(medicaid90791.lowest.low, medicaid90791.lowest.high)}), across {medicaid90791.n} {medicaid90791.noun}.</p>
      )}
      {medicaid90834 && (
        <p class="lede" style="margin-top:16px">For 90834, the highest Medicaid range is in <a href={ratePath(medicaid90834.highest.state, '90834')}>{stateName(medicaid90834.highest.state)}</a> ({fmtRange(medicaid90834.highest.low, medicaid90834.highest.high)}) and the lowest is in <a href={ratePath(medicaid90834.lowest.state, '90834')}>{stateName(medicaid90834.lowest.state)}</a> ({fmtRange(medicaid90834.lowest.low, medicaid90834.lowest.high)}), across {medicaid90834.n} {medicaid90834.noun}.</p>
      )}
      {medicaid97153 && (
        <p class="lede" style="margin-top:16px">For 97153, the highest Medicaid range is in <a href={ratePath(medicaid97153.highest.state, '97153')}>{stateName(medicaid97153.highest.state)}</a> ({fmtRange(medicaid97153.highest.low, medicaid97153.highest.high)}) and the lowest is in <a href={ratePath(medicaid97153.lowest.state, '97153')}>{stateName(medicaid97153.lowest.state)}</a> ({fmtRange(medicaid97153.lowest.low, medicaid97153.lowest.high)}), across {medicaid97153.n} {medicaid97153.noun}.</p>
      )}
      {uhc90791 && (
        <p class="lede" style="margin-top:16px">For 90791, the highest UnitedHealthcare range is in <a href={ratePath(uhc90791.highest.state, '90791')}>{stateName(uhc90791.highest.state)}</a> ({fmtRange(uhc90791.highest.low, uhc90791.highest.high)}) and the lowest is in <a href={ratePath(uhc90791.lowest.state, '90791')}>{stateName(uhc90791.lowest.state)}</a> ({fmtRange(uhc90791.lowest.low, uhc90791.lowest.high)}), across {uhc90791.n} {uhc90791.noun}.</p>
      )}
      {uhc90834 && (
        <p class="lede" style="margin-top:16px">For 90834, the highest UnitedHealthcare range is in <a href={ratePath(uhc90834.highest.state, '90834')}>{stateName(uhc90834.highest.state)}</a> ({fmtRange(uhc90834.highest.low, uhc90834.highest.high)}) and the lowest is in <a href={ratePath(uhc90834.lowest.state, '90834')}>{stateName(uhc90834.lowest.state)}</a> ({fmtRange(uhc90834.lowest.low, uhc90834.lowest.high)}), across {uhc90834.n} {uhc90834.noun}.</p>
      )}
      {hub.payer === 'medicaid-ffs' && (
        <p class="lede" style="margin-top:16px">Among the {mediUhc90791.n} {mediUhc90791.noun} with both a Medicaid FFS and a UnitedHealthcare range, the Medicaid high is above the UnitedHealthcare high in {mediUhc90791.above} for 90791, {mediUhc90834.above} for 90834 and {mediUhc90837.above} for 90837.</p>
      )}
      {hub.payer === 'uhc' && (
        <p class="lede" style="margin-top:16px">Among the {mediUhc90791.n} {mediUhc90791.noun} with both a UnitedHealthcare and a Medicaid FFS range, the UnitedHealthcare high is above the Medicaid high in {mediUhc90791.n - mediUhc90791.above} for 90791, {mediUhc90834.n - mediUhc90834.above} for 90834 and {mediUhc90837.n - mediUhc90837.above} for 90837.</p>
      )}
      <p class="lede">Rates are negotiated, not fixed. A rate your entity negotiated needs a contract in your entity's name, so see <a href="/platform/contracting">payer contracting for telehealth</a>, how to <a href="/own-your-contracts">own your payer contracts</a>, and <a href="/own-your-contracts#rent-or-build">rent a PC vs build your own professional corporation</a>.</p>
      <p class="lede">Every payer for one code: {codeHubCodes.map((code, i) => <>{i > 0 ? ', ' : ''}<a href={codeHubPath(code)}>{codeHubH1(code)}</a></>)}.</p>
      <p class="small muted"><a href="/rates">All reimbursement rates by state and CPT code</a></p>
    </div>
  </section>
  <Section eyebrow="State and code" title={`${who} rates by state and CPT code`} tight>
    <p class="scroll-hint" aria-hidden="true">Scroll sideways to see every column.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>State</th>
            <th>Code</th>
            <th>Low</th>
            <th>High</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td>{stateName(row.state)}</td>
              <td><a href={ratePath(row.state, row.code)}>{row.code} in {stateName(row.state)}</a></td>
              <td>{fmtRate(row.low)}</td>
              <td>{fmtRate(row.high)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>
  <CtaBand
    title="Know the rate. Then get the contract."
    body="Send us your codes and states. We come back with payer order, timelines, and the ranges to plan on."
    primary={{ label: 'Get a contracting plan', href: '/contact?src=rates-payer' }}
    secondary={{ label: 'Rates hub', href: '/rates' }}
  />
</BaseLayout>
<style>
  .rate-head { padding: clamp(40px, 6vw, 72px) 0 8px; }
  .rate-head h1 { max-width: 22ch; font-size: clamp(28px, 4.4vw, 44px); }
  .scroll-hint { display: none; margin: 0 0 8px; font-size: 13px; color: var(--muted); }
  @media (max-width: 480px) { .scroll-hint { display: block; } }
</style>
