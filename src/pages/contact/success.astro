---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import { SITE } from '../../../site.config.mjs';
---
  <BaseLayout title="Thanks" description="We have your note. We will reply within one business day." noindex>
  <Section>
    <div class="ok">
      <div class="eyebrow">Received</div>
      <h1>Thanks. We will reply within one business day.</h1>
      {SITE.calendly ? (
        <>
          <p class="lede">If you would rather not wait, pick a time now.</p>
          <div class="cal"><iframe src={`${SITE.calendly}?hide_gdpr_banner=1&background_color=f7f4ee&primary_color=c4552d`} title="Book a time" loading="lazy"></iframe></div>
        </>
      ) : (
        <p class="lede">A booking calendar publishes here when it is live. Prefer email now? <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      )}
      <div class="btn-group" style="margin-top:24px"><a href="/rates" class="btn btn-primary">Look up rates while you wait</a><a href="/resources" class="btn btn-ghost">Read the resources</a></div>
    </div>
  </Section>
  <script is:inline>
    (function () {
      try {
        var raw = sessionStorage.getItem('anvil_lead_pending');
        sessionStorage.removeItem('anvil_lead_pending');
        if (!raw || raw === '1') return;
        var data = JSON.parse(raw);
        if (!data || !data.form_name || !data.page_path || !data.form_location) return;
        if (!data.at || Date.now() - data.at > 120000) return;
        if (localStorage.getItem('anvil_consent') !== 'allow') return;
        if (typeof window.gtag !== 'function') return;
        var params = {
          form_name: data.form_name,
          form_page_path: data.page_path,
          form_location: data.form_location,
        };
        var debugValue = new URLSearchParams(location.search).get('debug_mode');
        var debugOn = data.debug_mode || (new URLSearchParams(location.search).has('debug_mode') && debugValue !== '0' && debugValue !== 'false');
        if (debugOn) params.debug_mode = true;
        window.gtag('event', 'generate_lead', params);
        if (new URLSearchParams(location.search).get('src') === 'newsletter') {
          window.gtag('event', 'sign_up', { method: 'newsletter' });
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
<style>
  .ok { max-width: 760px; }
  .ok h1 { font-size: clamp(30px, 4vw, 44px); }
  .cal iframe { width: 100%; height: 700px; border: 0; border-radius: var(--radius); background: var(--surface); }
</style>
