---
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../../site.config.mjs';
import { orgJsonLd, websiteJsonLd, absolute, cleanPath } from '../lib/seo';

interface Props {
  title: string;          // under 60 chars
  description: string;    // under 155 chars
  path?: string;          // canonical path, defaults to current
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Use the title string as the document title, with no "| Anvil" suffix. */
  exactTitle?: boolean;
}
const { title, description, ogImage = '/og-default-v2.png', jsonLd = [], noindex = false, type = 'website', exactTitle = false } = Astro.props;
const path = cleanPath(Astro.props.path ?? Astro.url.pathname);
const canonical = absolute(path);
const fullTitle = exactTitle || title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ld = [orgJsonLd(), websiteJsonLd(), ...jsonLd];
const ga4Id = import.meta.env.PUBLIC_GA4 || SITE.ga4 || '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="kmhVzCsKXuPFIeu7iSgTNwXg7hvK0VTEbN_k7UTXSL0" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f2e2a" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {ga4Id && (
      <script is:inline define:vars={{ ga4Id }}>
        (function () {
          if (!ga4Id) return;
          function loadGa() {
            if (window.__anvilGaLoaded) return;
            window.__anvilGaLoaded = true;
            window.dataLayer = window.dataLayer || [];
            function gtag(){ dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', ga4Id, { anonymize_ip: true });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
            document.head.appendChild(s);
          }
          try {
            if (localStorage.getItem('anvil_consent') === 'allow') loadGa();
            window.addEventListener('anvil:consent', function (e) {
              if (e.detail === 'allow') loadGa();
            });
          } catch (err) {}
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script>
      // Scroll reveal, respects reduced motion.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((e) => e.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((e) => io.observe(e));
      }
      // Persist attribution (UTM, referrer, /go/ slug) for the contact form.
      try {
        const p = new URLSearchParams(location.search);
        const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'src'];
        const store = JSON.parse(sessionStorage.getItem('anvil_attr') || '{}');
        let changed = false;
        for (const k of keys) if (p.get(k)) { store[k] = p.get(k); changed = true; }
        if (!store.referrer && document.referrer && !document.referrer.includes(location.host)) { store.referrer = document.referrer; changed = true; }
        if (!store.landing) { store.landing = location.pathname; changed = true; }
        if (changed) sessionStorage.setItem('anvil_attr', JSON.stringify(store));
      } catch {}
      // Remember a Netlify form submit so /contact/success can fire generate_lead.
      // Runs after each form's own submit handler, so a blocked submit never qualifies.
      document.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (!form.hasAttribute('data-netlify')) return;
        if (event.defaultPrevented) return;
        const trap = form.querySelector('[name="bot-field"]');
        if (trap && 'value' in trap && String(trap.value).trim() !== '') return;
        const netlifyName = form.getAttribute('name') || 'lead';
        const path = location.pathname;
        const formNames: Record<string, string> = {
          'anvil-leads': 'inquiry',
          newsletter: 'newsletter',
          'calculator-export': 'calculator',
          'baa-request': 'baa',
          'diligence-checklist': 'diligence_checklist',
          'readiness-checklist': 'readiness_checklist',
          'credentialing-benchmark': 'credentialing_benchmark',
          'cpom-map-2027': 'cpom_map',
          'audit-checklist': 'audit_checklist',
        };
        let formLocation = 'inline';
        if (netlifyName === 'anvil-leads') formLocation = 'contact_page';
        else if (netlifyName === 'newsletter') formLocation = path.startsWith('/resources/') && path !== '/resources' ? 'article_sidebar' : 'resources_sidebar';
        else if (netlifyName === 'calculator-export') formLocation = 'pricing_calculator';
        else if (netlifyName === 'baa-request') formLocation = 'baa_page';
        else if (netlifyName === 'diligence-checklist' && path.startsWith('/own-your-contracts')) formLocation = 'own_your_contracts';
        else if (path.startsWith('/resources/')) formLocation = 'article_inline';
        const debugValue = new URLSearchParams(location.search).get('debug_mode');
        const debugMode = new URLSearchParams(location.search).has('debug_mode') && debugValue !== '0' && debugValue !== 'false';
        try {
          sessionStorage.setItem('anvil_lead_pending', JSON.stringify({
            form_name: formNames[netlifyName] || netlifyName,
            page_path: path,
            form_location: formLocation,
            debug_mode: debugMode,
            at: Date.now(),
          }));
        } catch (err) {}
      });
    </script>
  </body>
</html>
