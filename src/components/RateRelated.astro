---
import Section from './Section.astro';

const links = [
  { href: '/own-your-contracts', label: 'Own your payer contracts' },
  { href: '/platform/contracting', label: 'Payer contracting for telehealth' },
  { href: '/platform/credentialing', label: 'Telehealth credentialing services' },
  { href: '/compare/bridge', label: 'Bridge alternative for telehealth insurance billing' },
  { href: '/solutions/switching', label: 'Switching from a network rental vendor' },
];
---
<Section eyebrow="Related" title="From the rate to the contract" tight>
  <ul class="check-list">
    {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</Section>
