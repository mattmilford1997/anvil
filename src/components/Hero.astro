---
import ProductMock from './ProductMock.astro';
interface Props {
  eyebrow?: string;
  title: string;
  sub: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  secondaryAs?: 'button' | 'link';
  mock?: boolean;
  compact?: boolean;
  /** Exact prompt, rendered as an H2 directly under the H1. */
  prompt?: string;
  promptId?: string;
  /** 40 to 60 word direct answer, plain text under the prompt. */
  answer?: string;
  /** Extra hero sentences. Hidden on small screens so the primary CTA stays in the first view. */
  subMore?: string;
  /** Desktop: put the primary CTA above the direct answer. Mobile order stays as it is. */
  ctaFirst?: boolean;
}
const { eyebrow, title, sub, primary = { label: 'Get started', href: '/contact' }, secondary, secondaryAs = 'button', mock = false, compact = false, prompt, promptId, answer, subMore, ctaFirst = false } = Astro.props;
---
<section class:list={['hero', { compact, 'has-mock': mock, 'cta-first': ctaFirst }]}>
  <canvas class="dots" aria-hidden="true"></canvas>
  <div class="container hero-in">
    <div class="hero-copy">
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h1 set:html={title} />
      {prompt && <h2 id={promptId} class="hero-q">{prompt}</h2>}
      {answer && <p class="lede direct-answer">{answer}</p>}
      <p class="lede">{sub}{subMore && !ctaFirst && <> <span class="hero-more">{subMore}</span></>}</p>
      <div class="btn-group">
        <a href={primary.href} class="btn btn-primary btn-lg">{primary.label}</a>
        {secondary && secondaryAs === 'button' && <a href={secondary.href} class="btn btn-ghost btn-lg">{secondary.label}</a>}
      </div>
      {secondary && secondaryAs === 'link' && (
        <p class="hero-alt"><a href={secondary.href}>{secondary.label}</a></p>
      )}
      {subMore && ctaFirst && <p class="lede hero-more-block">{subMore}</p>}
      <slot name="below" />
    </div>
    {mock && <div class="hero-mock"><ProductMock /></div>}
  </div>
</section>
<style>
  .hero { position: relative; overflow: hidden; padding: clamp(56px, 9vw, 120px) 0 clamp(48px, 7vw, 96px); }
  .hero.compact { padding: clamp(48px, 7vw, 88px) 0 clamp(32px, 5vw, 56px); }
  .dots { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.5; pointer-events: none; }
  .hero-in { position: relative; display: grid; gap: 48px; align-items: center; }
  .hero-in > * { min-width: 0; }
  .has-mock .hero-in { grid-template-columns: 1.05fr 0.95fr; }
  .hero h1 { max-width: 16ch; }
  .hero-q { font-size: clamp(22px, 2.6vw, 30px); max-width: 34ch; line-height: 1.2; margin: 4px 0 12px; }
  .direct-answer { margin-bottom: 12px; }
  .hero :global(h1 em) { font-style: normal; color: var(--accent); }
  .hero :global(h1 s) { text-decoration-color: var(--accent); text-decoration-thickness: 3px; color: var(--muted); }
  .lede { margin-bottom: 28px; }
  .hero-alt { margin: 16px 0 0; font-size: 15px; }
  .hero-alt a { color: var(--muted); font-weight: 500; }
  .hero-alt a:hover { color: var(--accent); }
  @media (max-width: 960px) { .has-mock .hero-in { grid-template-columns: 1fr; } .hero-mock { max-width: 560px; } }
  @media (max-width: 480px) {
    .hero:not(.compact) { padding: 24px 0 28px; }
    .hero:not(.compact) .hero-copy { display: flex; flex-direction: column; }
    .hero:not(.compact) .hero-q { order: 1; margin-bottom: 8px; }
    .hero:not(.compact) .lede:not(.direct-answer) { order: 2; margin-bottom: 16px; }
    .hero:not(.compact) .btn-group { order: 3; }
    .hero:not(.compact) .hero-alt { order: 4; margin-top: 12px; }
    .hero:not(.compact) .direct-answer { order: 5; margin-top: 20px; margin-bottom: 0; }
    .hero:not(.compact) .hero-more { display: none; }
    .hero:not(.compact) .hero-more-block { display: none; }
  }
  @media (min-width: 481px) {
    .hero.cta-first .hero-copy { display: flex; flex-direction: column; }
    .hero.cta-first .direct-answer { order: 5; margin-top: 24px; }
    .hero.cta-first .hero-more-block { order: 6; margin-bottom: 0; }
    .hero.cta-first .lede:not(.direct-answer):not(.hero-more-block) { margin-bottom: 20px; }
  }
</style>
<script>
  // Low-contrast animated dot field. Skipped when reduced motion is set.
  const c = document.querySelector<HTMLCanvasElement>('.hero .dots');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (c) {
    const ctx = c.getContext('2d')!;
    let w = 0, h = 0, t = 0, raf = 0;
    const spacing = 28, size = 1.6;
    const resize = () => { const r = c.getBoundingClientRect(); w = c.width = Math.floor(r.width); h = c.height = Math.floor(r.height); draw(); };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (let y = spacing / 2; y < h; y += spacing) {
        for (let x = spacing / 2; x < w; x += spacing) {
          const d = Math.hypot(x - w * 0.7, y - h * 0.4);
          const wave = reduce ? 0 : Math.sin(d / 60 - t) * 0.5 + 0.5;
          const a = 0.12 + wave * 0.28;
          ctx.fillStyle = `rgba(15,46,42,${a.toFixed(3)})`;
          ctx.beginPath(); ctx.arc(x, y, size + wave * 0.6, 0, Math.PI * 2); ctx.fill();
        }
      }
    };
    const loop = () => { t += 0.02; draw(); raf = requestAnimationFrame(loop); };
    resize(); window.addEventListener('resize', resize);
    if (!reduce) { raf = requestAnimationFrame(loop); document.addEventListener('visibilitychange', () => { if (document.hidden) cancelAnimationFrame(raf); else raf = requestAnimationFrame(loop); }); }
  }
</script>
