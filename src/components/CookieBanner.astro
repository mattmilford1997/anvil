<div id="cookie" class="cookie" hidden role="region" aria-label="Cookie notice">
  <p>We use analytics cookies to understand how this site is used. No health information is collected here. <a href="/legal/privacy">Privacy policy</a></p>
  <div class="cookie-btns">
    <button type="button" class="btn btn-ghost" data-consent="deny">Decline</button>
    <button type="button" class="btn btn-primary" data-consent="allow">Accept</button>
  </div>
</div>
<style>
  .cookie { position: fixed; bottom: 16px; left: 16px; right: 16px; max-width: 560px; margin-inline: auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px 18px; z-index: 60; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; font-size: 14px; }
  .cookie[hidden] { display: none; }
  .cookie p { margin: 0; flex: 1 1 300px; }
  .cookie-btns { display: flex; gap: 8px; }
  .cookie .btn { padding: 8px 14px; font-size: 14px; }
</style>
<script>
  const el = document.getElementById('cookie');
  try {
    if (el && !localStorage.getItem('anvil_consent')) el.hidden = false;
    el?.querySelectorAll('[data-consent]').forEach((b) => b.addEventListener('click', () => {
      localStorage.setItem('anvil_consent', (b as HTMLElement).dataset.consent!);
      el!.hidden = true;
      window.dispatchEvent(new CustomEvent('anvil:consent', { detail: (b as HTMLElement).dataset.consent }));
    }));
  } catch {}
</script>
