---
interface Props { title?: string; body?: string; compact?: boolean }
const { title = 'The insurance memo', body = 'Biweekly. One number, one take, one link. 400 words.', compact = false } = Astro.props;
---
<div class:list={['nl card', { compact }]}>
  <h3>{title}</h3>
  <p class="muted">{body}</p>
  <form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/success?src=newsletter" class="nl-form">
    <input type="hidden" name="form-name" value="newsletter" />
    <p class="hp"><label>Leave empty <input name="bot-field" /></label></p>
    <label for="nl-email" class="sr-only">Work email</label>
    <input id="nl-email" type="email" name="email" placeholder="Work email" required />
    <button type="submit" class="btn btn-primary">Subscribe</button>
  </form>
</div>
<style>
  .nl h3 { font-size: 20px; margin-bottom: 4px; }
  .nl-form { display: flex; gap: 8px; flex-wrap: wrap; }
  .nl-form input[type=email] { flex: 1 1 180px; font: inherit; font-size: 15px; padding: 10px 14px; border: 1.5px solid var(--border); border-radius: 999px; }
</style>
