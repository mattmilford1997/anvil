---
import { faqJsonLd } from '../lib/seo';
interface Props { items: { q: string; a: string }[]; title?: string; schema?: boolean }
const { items, title = 'Questions, answered', schema = true } = Astro.props;
---
{schema && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd(items))} />}
<div class="faq">
  {title && <h2>{title}</h2>}
  <div class="faq-list">
    {items.map((f) => (
      <details class="faq-item">
        <summary>{f.q}<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></summary>
        <div class="faq-a"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</div>
<style>
  .faq h2 { margin-bottom: 20px; }
  .faq-list { display: grid; gap: 8px; }
  .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 0 20px; }
  .faq-item summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; font-weight: 600; cursor: pointer; list-style: none; color: var(--ink); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary svg { transform: rotate(180deg); }
  .faq-item svg { flex-shrink: 0; transition: transform 0.2s; color: var(--muted); }
  .faq-a { padding: 0 0 16px; color: var(--muted); }
  .faq-a p { margin: 0; }
</style>
