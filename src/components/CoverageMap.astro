---
import { tile, coverage, stateNames, coverageSummary } from '../data/coverage';
interface Props { id?: string; title?: string }
const { id = 'coverage', title = 'Where you can bill today' } = Astro.props;
const cell = 44, gap = 4;
const W = 12 * (cell + gap), H = 8 * (cell + gap);
const entries = Object.entries(tile);
---
<div class="cov" id={id}>
  <div class="cov-head">
    <div>
      <h3>{title}</h3>
      <p class="muted small">Tap a state. Data maintained by our ops team, updated as payers come live.</p>
    </div>
    <div class="legend" role="group" aria-label="Map layer">
      <button type="button" class="on" data-layer="rented"><i class="sw sw-rented"></i>Live on rented PC ({coverageSummary.rented})</button>
      <button type="button" data-layer="contracting"><i class="sw sw-contracting"></i>Own-PC contracting ({coverageSummary.contracting})</button>
      <button type="button" data-layer="medicaid"><i class="sw sw-medicaid"></i>Medicaid live ({coverageSummary.medicaid})</button>
    </div>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="map" role="img" aria-label="United States coverage map by state">
    {entries.map(([abbr, [x, y]]) => {
      const c = coverage[abbr];
      return (
        <g class="st" data-abbr={abbr} data-rented={c.rented} data-contracting={c.contracting} data-medicaid={c.medicaid} tabindex="0" role="button" aria-label={`${stateNames[abbr]}: ${c.rented ? 'live on rented PC' : 'not live'}${c.medicaid ? ', Medicaid live' : ''}`}>
          <rect x={x * (cell + gap)} y={y * (cell + gap)} width={cell} height={cell} rx="6" />
          <text x={x * (cell + gap) + cell / 2} y={y * (cell + gap) + cell / 2 + 5} text-anchor="middle">{abbr}</text>
        </g>
      );
    })}
  </svg>
  <div class="tip" aria-live="polite"></div>
</div>
<style>
  .cov { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; }
  .cov-head { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 16px; }
  .cov h3 { margin-bottom: 4px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; }
  .legend button { display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: 13px; font-weight: 500; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; color: var(--text); }
  .legend button.on { border-color: var(--ink); background: var(--surface-2); }
  .sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .sw-rented { background: var(--ink-3); } .sw-contracting { background: #7a9c94; } .sw-medicaid { background: var(--accent); }
  .map { width: 100%; max-width: 640px; height: auto; margin-inline: auto; display: block; }
  .st rect { fill: var(--surface-2); transition: fill 0.15s; cursor: pointer; }
  .st text { font-size: 12px; font-weight: 600; fill: var(--muted); pointer-events: none; }
  .st.on rect { fill: var(--fill); }
  .st.on text { fill: #fff; }
  .st:hover rect, .st:focus rect { stroke: var(--ink); stroke-width: 2; outline: none; }
  .tip { min-height: 24px; margin-top: 12px; font-size: 14px; color: var(--ink); text-align: center; }
</style>
<script>
  const fills: Record<string, string> = { rented: '#245c54', contracting: '#7a9c94', medicaid: '#c4552d' };
  document.querySelectorAll<HTMLElement>('.cov').forEach((cov) => {
    const states = cov.querySelectorAll<SVGGElement>('.st');
    const tip = cov.querySelector<HTMLElement>('.tip')!;
    const apply = (layer: string) => {
      states.forEach((s) => { const on = s.dataset[layer] === 'true'; s.classList.toggle('on', on); s.style.setProperty('--fill', fills[layer]); });
    };
    cov.querySelectorAll<HTMLButtonElement>('.legend button').forEach((b) => b.addEventListener('click', () => {
      cov.querySelectorAll('.legend button').forEach((x) => x.classList.remove('on')); b.classList.add('on'); apply(b.dataset.layer!);
    }));
    const show = (s: SVGGElement) => { tip.textContent = s.getAttribute('aria-label'); };
    states.forEach((s) => { s.addEventListener('mouseenter', () => show(s)); s.addEventListener('focus', () => show(s)); s.addEventListener('click', () => show(s)); });
    apply('rented');
  });
</script>
