---
interface Step { when: string; title: string; bullets: string[]; metric: { value: string; label: string }; art: 'enroll' | 'billing' | 'migrate' | 'own' }
interface Props { steps?: Step[] }
const defaults: Step[] = [
  { when: 'Week 1', title: 'Enroll under our contracts. Form your PC.', bullets: ['Clinician rosters submitted to our payer contracts', 'Your PC formed in launch states, physician owner matched', 'Eligibility API keys and sandbox issued to your engineers'], metric: { value: 'Day 1', label: 'both tracks start' }, art: 'enroll' },
  { when: 'Week 4', title: 'You are billing in-network.', bullets: ['Eligibility runs at booking, copay shown before the visit', 'Claims go out under our PC, we carry the claims risk', 'Statements show contracted rate and platform fee separately'], metric: { value: 'Weeks', label: 'to first insured visit' }, art: 'billing' },
  { when: 'Month 6', title: 'Your PC is contracted with its first payers.', bullets: ['Commercial contracts executed in your entity\'s name', 'Clinicians credentialed under your PC', 'New visits with those payers route to your PC'], metric: { value: '2 entities', label: 'billing in parallel, no gap' }, art: 'migrate' },
  { when: 'Month 12', title: 'Majority of volume on your own contracts.', bullets: ['Rates, renewals, and payer relationships are yours', 'Platform fee steps down as volume migrates', 'Diligence question answered: you own the asset'], metric: { value: 'Yours', label: 'contracts, rates, files' }, art: 'own' },
];
const steps = Astro.props.steps ?? defaults;
---
<div class="tl">
  {steps.map((s, i) => (
    <div class:list={['row reveal', { flip: i % 2 === 1 }]}>
      <div class="art" aria-hidden="true">
        <div class:list={['art-in', s.art]}>
          {s.art === 'enroll' && <><div class="chip">Roster submitted</div><div class="chip chip-2">PC formed: TX, FL, CA</div><div class="chip chip-3">API keys issued</div></>}
          {s.art === 'billing' && <><div class="elig"><span>Eligibility</span><strong>Covered. Est. copay $25</strong></div><div class="chip chip-2">Claim 837P sent</div></>}
          {s.art === 'migrate' && <><div class="two"><div class="ent">Anvil PC<span class="bar"><span style="width:55%"></span></span></div><div class="ent">Your PC<span class="bar"><span style="width:45%;background:var(--accent)"></span></span></div></div></>}
          {s.art === 'own' && <><div class="two"><div class="ent">Anvil PC<span class="bar"><span style="width:20%"></span></span></div><div class="ent">Your PC<span class="bar"><span style="width:80%;background:var(--accent)"></span></span></div></div><div class="chip chip-3">Fee stepped down</div></>}
        </div>
      </div>
      <div class="copy">
        <div class="when">{s.when}</div>
        <h3>{s.title}</h3>
        <ul class="check-list">{s.bullets.map((b) => <li>{b}</li>)}</ul>
        <div class="metric"><strong>{s.metric.value}</strong><span>{s.metric.label}</span></div>
      </div>
    </div>
  ))}
</div>
<style>
  .tl { display: grid; gap: 40px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .row.flip .art { order: 2; }
  .art { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); min-height: 260px; display: flex; align-items: center; justify-content: center; padding: 28px; box-shadow: 0 1px 2px rgba(15,46,42,0.04); }
  .art-in { display: grid; gap: 12px; width: 100%; max-width: 360px; }
  .chip { background: var(--surface-2); border-radius: 10px; padding: 12px 14px; font-weight: 600; font-size: 14px; color: var(--ink); }
  .chip-2 { margin-left: 24px; }
  .chip-3 { margin-left: 48px; background: var(--accent-soft); color: var(--accent); }
  .elig { background: var(--ink); color: #fff; border-radius: 12px; padding: 16px; display: grid; gap: 4px; }
  .elig span { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: #b7c7c2; }
  .two { display: grid; gap: 14px; }
  .ent { font-weight: 600; font-size: 14px; display: grid; gap: 6px; }
  .bar { height: 10px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
  .bar span { display: block; height: 100%; background: var(--ink-3); border-radius: 999px; }
  .when { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .copy h3 { font-size: 26px; }
  .metric { display: flex; align-items: baseline; gap: 10px; margin-top: 8px; }
  .metric strong { font-size: 28px; color: var(--ink); letter-spacing: -0.02em; }
  .metric span { color: var(--muted); }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; gap: 20px; } .row.flip .art { order: 0; } .art { min-height: 180px; } }
</style>
