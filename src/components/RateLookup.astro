---
/**
 * Rate lookup. Data source is Parite via /rates.json.
 * Dropdowns only include CPT codes that have at least one real row.
 * Missing codes (99214, 99213, 96158, 99484 in the Sep 2026 export) are omitted, not padded.
 */
import { servicesInData, payerLabels, rateStateNames } from '../lib/rates';
interface Props { compact?: boolean; id?: string }
const { compact = false, id = 'rate-lookup' } = Astro.props;
const services = servicesInData();
const states = Object.entries(rateStateNames).sort((a, b) => a[1].localeCompare(b[1]));
---
<div
  class:list={['rl card', { compact }]}
  id={id}
  data-rates-src="/rates.json"
  data-payer-labels={JSON.stringify(payerLabels)}
>
  <div class="rl-head">
    <div>
      <div class="eyebrow">Rate lookup</div>
      <h3>{compact ? 'What do payers pay for your codes?' : 'Published reimbursement rates by state and CPT code'}</h3>
      {!compact && <p class="muted">Ranges are drawn from contracted and published rates for the state and code. They are ranges, not guarantees. The lookup lists the codes Parite has numbers for.</p>}
    </div>
  </div>
  <form class="rl-form" onsubmit="return false">
    <div class="field">
      <label for={`${id}-state`}>State</label>
      <select id={`${id}-state`} name="state">
        <option value="">Choose a state</option>
        {states.map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-code`}>Service or CPT code</label>
      <select id={`${id}-code`} name="code">
        <option value="">Choose a service</option>
        {services.map((s) => <option value={s.code}>{s.label}</option>)}
      </select>
      {!compact && <span class="hint">If a code you bill is missing, ask us. We add codes when Parite has the numbers.</span>}
    </div>
    {!compact && (
      <div class="field">
        <label for={`${id}-payer`}>Payer (optional)</label>
        <select id={`${id}-payer`} name="payer"><option value="">All payers</option></select>
      </div>
    )}
  </form>
  <div class="rl-out" aria-live="polite">
    <p class="muted">Pick a state and a code to see the range.</p>
  </div>
  <div class="rl-foot">
    {compact ? <a href="/rates" class="btn btn-ghost">See full data</a> : <a href="/contact?src=rates" class="btn btn-primary">Get a contracting plan for your codes</a>}
    <span class="small muted">Source: Parite. No form required.</span>
  </div>
</div>
<style>
  .rl { padding: 28px; }
  .rl-head h3 { margin-bottom: 6px; }
  .rl-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 16px; margin-top: 12px; }
  .rl-out { min-height: 64px; background: var(--surface-2); border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; }
  .rl-out p { margin: 0; }
  .rl-out .range { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .rl-out .range strong { font-size: 28px; color: var(--ink); letter-spacing: -0.02em; }
  .rl-out table { margin-top: 12px; font-size: 14px; }
  .rl-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .hint { font-size: 13px; color: var(--muted); }
</style>
<script>
  type Row = { state: string; code: string; payer?: string; low: number; high: number; median?: number; source?: string };
  const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const payerName = (p: string | undefined, labels: Record<string, string>) => (p && labels[p]) || p || 'Blended';
  document.querySelectorAll<HTMLElement>('.rl').forEach(async (rl) => {
    const out = rl.querySelector<HTMLElement>('.rl-out')!;
    const form = rl.querySelector<HTMLFormElement>('.rl-form')!;
    const stateSel = form.querySelector<HTMLSelectElement>('[name=state]')!;
    const codeSel = form.querySelector<HTMLSelectElement>('[name=code]')!;
    const payerSel = form.querySelector<HTMLSelectElement>('[name=payer]');
    const labels = JSON.parse(rl.dataset.payerLabels || '{}') as Record<string, string>;
    const codeOptions = [...codeSel.querySelectorAll('option')].filter((o) => o.value).map((o) => ({ value: o.value, label: o.textContent || o.value }));
    let rows: Row[] = [];
    try { const r = await fetch(rl.dataset.ratesSrc!); if (r.ok) rows = (await r.json()).rates || []; } catch {}
    const codesForState = (st: string) => {
      const have = new Set(rows.filter((r) => !st || r.state === st).map((r) => r.code));
      return codeOptions.filter((c) => have.has(c.value));
    };
    const fillCodes = () => {
      if (!rows.length) return;
      const st = stateSel.value;
      const keep = codesForState(st);
      const prev = codeSel.value;
      codeSel.innerHTML = '<option value="">Choose a service</option>' + keep.map((c) => `<option value="${c.value}">${c.label}</option>`).join('');
      if (keep.some((c) => c.value === prev)) codeSel.value = prev;
    };
    const fillPayers = () => {
      if (!payerSel) return;
      const st = stateSel.value, code = codeSel.value;
      const payers = [...new Set(rows.filter((r) => (!st || r.state === st) && (!code || r.code === code)).map((r) => r.payer).filter(Boolean))] as string[];
      const prev = payerSel.value;
      payerSel.innerHTML = '<option value="">All payers</option>' + payers.sort().map((p) => `<option value="${p}">${payerName(p, labels)}</option>`).join('');
      if (payers.includes(prev)) payerSel.value = prev;
    };
    const render = () => {
      const st = stateSel.value, code = codeSel.value, payer = payerSel?.value || '';
      if (!st || !code) { out.innerHTML = '<p class="muted">Pick a state and a code to see the range.</p>'; return; }
      const hits = rows.filter((r) => r.state === st && r.code === code && (!payer || r.payer === payer));
      if (!hits.length) {
        out.innerHTML = `<p><strong>No published range for ${code} in ${st}.</strong> <span class="muted">Ask us for this state and code and we will send what we have. More codes ship when Parite has them.</span></p>`;
        return;
      }
      const low = Math.min(...hits.map((h) => h.low)), high = Math.max(...hits.map((h) => h.high));
      const rangeText = low === high ? money(low) : `${money(low)} to ${money(high)}`;
      const href = `/rates/${st.toLowerCase()}/${code}`;
      let html = `<div class="range"><strong>${rangeText}</strong><span class="muted">per unit, ${hits.length} payer${hits.length > 1 ? 's' : ''} in ${st}</span></div>`;
      html += '<table><thead><tr><th>Payer</th><th>Low</th><th>High</th><th>Median</th><th>Source</th></tr></thead><tbody>' +
        hits.map((h) => `<tr><td>${payerName(h.payer, labels)}</td><td>${money(h.low)}</td><td>${money(h.high)}</td><td>${h.median != null ? money(h.median) : 'n/a'}</td><td>${h.source || 'Parite'}</td></tr>`).join('') +
        '</tbody></table>';
      html += `<p class="small" style="margin-top:12px"><a href="${href}">${code} reimbursement rate in ${st} by payer (2026)</a></p>`;
      out.innerHTML = html;
    };
    stateSel.addEventListener('change', () => { fillCodes(); fillPayers(); render(); });
    codeSel.addEventListener('change', () => { fillPayers(); render(); });
    payerSel?.addEventListener('change', render);
    fillCodes();
    fillPayers();
  });
</script>
