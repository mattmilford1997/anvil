---
import { portfolio } from '../data/portfolio';
import { coverageSummary } from '../data/coverage';
// Until there are 8+ external customer logos, show portfolio companies with the "Operated by our team" label.
const items = [...portfolio, ...portfolio];
---
<div class="strip" aria-label="Care companies on Anvil">
  <p class="strip-label">Care companies billing in {coverageSummary.rented} states. <span class="muted">Operated by our team.</span></p>
  <div class="marquee">
    <ul class="track">
      {items.map((c, i) => <li aria-hidden={i >= portfolio.length ? 'true' : undefined}>{c.name}</li>)}
    </ul>
  </div>
</div>
<style>
  .strip { padding: 28px 0 8px; }
  .strip-label { text-align: center; font-size: 14px; font-weight: 600; color: var(--ink); margin-bottom: 18px; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; gap: 56px; list-style: none; margin: 0; padding: 0; width: max-content; animation: scroll 32s linear infinite; }
  .track li { font-weight: 700; font-size: 22px; letter-spacing: -0.02em; color: var(--muted); white-space: nowrap; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; justify-content: center; width: auto; } .track li[aria-hidden] { display: none; } }
</style>
