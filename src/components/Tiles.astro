---
interface Props { items: { title: string; body: string; icon?: string; href?: string }[]; cols?: 2 | 3 | 4 }
const { items, cols = 3 } = Astro.props;
const icons: Record<string, string> = {
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M15 6l3 3M18 3l3 3"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  shield: '<path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z"/>',
  api: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"/>',
  users: '<circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-7 7-7s7 3 7 7M17 4a4 4 0 010 8M22 21c0-3-2-6-5-7"/>',
  map: '<path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  file: '<path d="M6 2h8l6 6v14H6zM14 2v6h6M9 13h6M9 17h6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
};
---
<div class:list={['grid', `grid-${cols}`]}>
  {items.map((it) => (
    <div class="card tile reveal">
      {it.icon && icons[it.icon] && (
        <span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]} /></span>
      )}
      <h3>{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h3>
      <p>{it.body}</p>
    </div>
  ))}
</div>
<style>
  .tile h3 { font-size: 20px; margin: 0 0 8px; }
  .tile h3 a { text-decoration: none; color: inherit; }
  .tile h3 a:hover { color: var(--accent); }
  .tile p { color: var(--muted); font-size: 16px; }
  .ico { display: inline-flex; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 10px; background: var(--accent-soft); color: var(--accent); margin-bottom: 16px; }
</style>
