---
// Inquiry form v2. Netlify Form "anvil-leads". Netlify detects it from built HTML at deploy time.
// Attribution (UTM, referrer, landing, go slug) stays in sessionStorage and is sent to GA4 on
// /contact/success, not as named Netlify fields, so those values do not appear in lead emails.
---
<form name="anvil-leads" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/success" class="cf card" id="contact-form" aria-describedby="cf-privacy">
  <input type="hidden" name="form-name" value="anvil-leads" />
  <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="field-row">
    <div class="field">
      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="f-email">Work email</label>
      <input id="f-email" name="email" type="email" required autocomplete="email" inputmode="email" />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="f-company">Company</label>
      <input id="f-company" name="company" type="text" required autocomplete="organization" />
    </div>
    <div class="field">
      <label for="f-role">Role</label>
      <select id="f-role" name="role" required>
        <option value="">Choose</option>
        <option>CEO / Founder</option>
        <option>COO / Operations</option>
        <option>CFO / Finance</option>
        <option>Engineering / Product</option>
        <option>Clinical leadership</option>
        <option>Other</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="f-states">Which states?</label>
    <input id="f-states" name="states" type="text" required autocomplete="off" placeholder="e.g. CA, TX, NY or all 50" aria-describedby="f-states-hint" />
    <span class="hint" id="f-states-hint">Not sure yet? Type "not sure".</span>
  </div>

  <div class="field">
    <label for="f-need">What do you need?</label>
    <select id="f-need" name="need" required>
      <option value="">Choose</option>
      <option value="Payer contracting">Payer contracting</option>
      <option value="Launch on Anvil PC">Launch on Anvil PC</option>
      <option value="Credentialing">Credentialing</option>
      <option value="Billing and RCM">Billing and RCM</option>
      <option value="Switching vendors">Switching vendors</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="field">
    <label for="f-msg">Message</label>
    <textarea id="f-msg" name="message" rows="4" placeholder="Codes you bill, payers you care about, timeline."></textarea>
  </div>

  <p class="small muted" id="cf-privacy">We use these details to reply to your inquiry, as described in our <a href="/legal/privacy">privacy policy</a>. Please do not include patient information.</p>
  <p class="small cf-status" id="cf-status" role="status" aria-live="polite"></p>
  <button type="submit" class="btn btn-primary btn-lg">Send inquiry</button>
</form>
<style>
  .cf { position: relative; padding: 32px; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cf-status:empty { display: none; }
  @media (max-width: 600px) { .cf { padding: 20px; } .cf .btn { width: 100%; } }
</style>
<script>
  const f = document.getElementById('contact-form') as HTMLFormElement | null;
  if (f) {
    const started = Date.now();
    const status = document.getElementById('cf-status');
    // Light client-side guard: block submits under 2s from load, then one submit per 10s. Tell the person why.
    let last = 0;
    f.addEventListener('submit', (e) => {
      const now = Date.now();
      if (now - started < 2000) { e.preventDefault(); if (status) status.textContent = 'One moment, then press Send inquiry again.'; return; }
      if (now - last < 10000) { e.preventDefault(); if (status) status.textContent = 'Sending. Please wait a few seconds.'; return; }
      last = now;
    });
  }
</script>
